msgstr "Deze wijziging is in WooCommerce opgeslagen, maar niet verzonden naar %1$s, dat geen wijzigingen aan deze bestelling meer accepteert. De %1$s-factuur bevat deze niet."

#: class/WC_Twoinc.php:7457 class/WC_Twoinc.php:7489 class/WC_Twoinc.php:7496
#, php-format
msgid "Could not edit the order with %s."
msgstr "Kon de bestelling met %s niet bewerken."

#: class/WC_Twoinc.php:7511
#, php-format
msgid "The order edit request has been accepted by %s."
msgstr "Het verzoek tot het bewerken van de bestelling is geaccepteerd door %s ."

#: class/WC_Twoinc.php:7513
#, php-format
msgid "Order value is now %s."
msgstr "De orderwaarde is nu %s ."

#: class/WC_Twoinc.php:7858
#, php-format
msgid "Grow your B2B sales with Buy Now, Pay Later using %s!"
msgstr "Vergroot uw B2B-omzet met Koop nu, betaal later met %s !"

#: class/WC_Twoinc.php:7859
#, php-format
msgid "%s credit approves 90%% of business buyers, pays you upfront and minimise your risk. To offer %s in your checkout, you need to signup. It is quick, easy and gives you immediate access to the %s Merchant Portal."
msgstr "%s credit keurt 90%% van de zakelijke kopers goed, betaalt u vooraf en minimaliseert uw risico. Om %s aan te bieden in uw checkout, moet u zich registreren. Het is snel, eenvoudig en geeft u direct toegang tot de %s Merchant Portal."

#: class/WC_Twoinc.php:7860
msgid "Set up my account"
msgstr "Mijn account instellen"

#. translators: 1: base plugin provenance, e.g. "2.23.9 (eb7bf92cec07, deployed 2026-07-08 11:35 UTC)"
#: class/WC_Twoinc.php:7946
#, php-format
msgid "Plugin: %s"
msgstr "Plug-in: %s"

#. translators: 1: overlay plugin slug, 2: overlay provenance
#: class/WC_Twoinc.php:7954
#, php-format
msgid "Brand overlay: %1$s %2$s"
msgstr "Merkoverlay: %1$s %2$s"

#. translators: 1: plugin (and overlay) provenance fragments, 2: WooCommerce version, 3: WordPress version
#: class/WC_Twoinc.php:7961
#, php-format
msgid "%1$s | WooCommerce: %2$s | WordPress: %3$s"
msgstr "%1$s | WooCommerce: %2$s | WordPress: %3$s"

#. translators: %s: UTC timestamp the code was deployed
#: class/WC_Twoinc.php:7993
