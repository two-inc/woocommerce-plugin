#: class/WC_Twoinc.php:1484
#, php-format
msgid "What is %s?"
msgstr "Wat is %s ?"

#: class/WC_Twoinc.php:1491
#, php-format
msgid "%s is a payment solution for B2B purchases online, allowing you to buy from your favourite merchants and suppliers on trade credit. Using %s, you can access flexible trade credit instantly to make purchasing simple."
msgstr "%s is een betaaloplossing voor B2B-aankopen online, waarmee u bij uw favoriete handelaren en leveranciers op handelskrediet kunt kopen. Met %s krijgt u direct toegang tot flexibel handelskrediet om aankopen eenvoudig te maken."

#: class/WC_Twoinc.php:1492 class/WC_Twoinc_Product_Promo.php:127
msgid "Buy now, receive your goods, pay your invoice later."
msgstr "Koop nu, ontvang uw goederen, betaal uw factuur later."

#: class/WC_Twoinc.php:1494
msgid "Click to find out more"
msgstr "Klik om meer te weten te komen"

#. translators: shown beside the spinner while the order-intent availability check runs.
#: class/WC_Twoinc.php:1558
msgid "Checking availability"
msgstr "Beschikbaarheid controleren"

#. translators: %1$s: brand product name (e.g. "Two"); %2$s: the buyer's captured company name and number, substituted client-side — reorderable, do not assume %1$s precedes %2$s in every locale
#: class/WC_Twoinc.php:1673
#, php-format
msgid "This order by %2$s is likely to be accepted by %1$s"
msgstr "Deze bestelling van %2$s wordt waarschijnlijk geaccepteerd door %1$s"

#: class/WC_Twoinc.php:1682
#, php-format
msgid "Your invoice with %1$s is likely to be accepted, subject to additional checks."
msgstr "Uw factuur met %1$s wordt waarschijnlijk geaccepteerd, mits er aanvullende controles worden uitgevoerd."

#: class/WC_Twoinc.php:1718 class/WC_Twoinc.php:5488 class/WC_Twoinc.php:5498
#: class/WC_Twoinc.php:5588 class/WC_Twoinc.php:5618
#: class/WC_Twoinc_Helper.php:281
#, php-format
msgid "Invoice purchase with %s is not available for this order."
msgstr "Aankoop op factuur met %s is niet beschikbaar voor deze bestelling."

#. translators: %1$s: brand product name (e.g. "Two"); %2$s: the buyer's captured company name and number, substituted client-side
#: class/WC_Twoinc.php:1734
#, php-format
msgid "%1$s is not available for this order by %2$s"
msgstr "%1$s is niet beschikbaar voor deze bestelling van %2$s"

#: class/WC_Twoinc.php:1822
msgid "Phone number is invalid."
msgstr "Telefoonnummer is ongeldig."

#: class/WC_Twoinc.php:1823
msgid "We could not complete that just now. Please wait a moment and try again."
msgstr "Dit kon niet worden voltooid. Probeer het zo weer opnieuw."

#: class/WC_Twoinc.php:1827
#, php-format
msgid "To pay with %s, search for your company name and select it from the results."
msgstr "Om met %s te betalen, zoek je bedrijfsnaam op en selecteer deze uit de resultaten."

#: class/WC_Twoinc.php:1845 class/WC_Twoinc.php:1865 class/WC_Twoinc.php:2891
#: class/WC_Twoinc.php:4186 class/WC_Twoinc_Checkout.php:673
#, php-format
msgid "%s days"
msgstr "%s dagen"

#: class/WC_Twoinc.php:1862 class/WC_Twoinc.php:4188
msgid "Automatic"
msgstr "Automatisch"

#: class/WC_Twoinc.php:1910
msgid "Rounding step must be one of the offered values."
msgstr "Afrondingsstap moet een van de aangeboden waarden zijn."

#: class/WC_Twoinc.php:1928
msgid "— select a tax class —"
msgstr "— selecteer een btw-klasse —"

#: class/WC_Twoinc.php:2013
msgid "-- Select surcharge tax treatment --"
msgstr "-- Selecteer BTW-behandeling voor toeslag --"

#: class/WC_Twoinc.php:2014
msgid "Standard (store default tax rules)"
msgstr "Standaard (standaard btw-regels van de winkel)"

#: class/WC_Twoinc.php:2015
msgid "Specific tax class"
msgstr "Specifieke btw-klasse"

#: class/WC_Twoinc.php:2016
msgid "Never taxed"
msgstr "Nooit belast"

#: class/WC_Twoinc.php:2059
msgid "⚠ This store is set to leave the surcharge UNTAXED for every destination. That treatment is no longer available and these settings cannot be saved while it is stored — select a tax treatment above. To keep the fee untaxed, create a tax class with a 0% rate under WooCommerce → Settings → Tax and select it as the surcharge tax class."
msgstr "⚠ Deze winkel is ingesteld om de toeslag ONBELAST te laten voor elke bestemming. Die behandeling is niet meer beschikbaar en deze instellingen kunnen niet worden opgeslagen zolang die is opgeslagen — selecteer hierboven een btw-behandeling. Wilt u de vergoeding onbelast houden, maak dan een btw-klasse met een tarief van 0% aan onder WooCommerce → Instellingen → Btw en selecteer die als btw-klasse van de toeslag."

#: class/WC_Twoinc.php:2082
#, php-format
msgid "⚠ The previously selected tax class (\"%s\") no longer exists. The surcharge is currently taxed under the Standard treatment — select an existing tax class or change the tax treatment above."
msgstr "⚠ De eerder geselecteerde btw-klasse (\"%s\") bestaat niet meer. De toeslag wordt momenteel belast volgens de Standaard-behandeling — selecteer een bestaande btw-klasse of wijzig hierboven de btw-behandeling."

#. translators: %s: submitted value
#: class/WC_Twoinc.php:2211
#, php-format
msgid "Unrecognised value for the product page message switch: %s."
msgstr "Onbekende waarde voor de instelling voor het productpaginabericht: %s."

#. translators: %s: the type of the submitted value
#: class/WC_Twoinc.php:2236
#, php-format
msgid "Product page message accepts text only; a %s was submitted."
msgstr "Het productpaginabericht accepteert alleen tekst; er is een %s verzonden."

#. translators: %s: submitted value
#: class/WC_Twoinc.php:2270
#, php-format
msgid "Unrecognised value for the product page button switch: %s."
msgstr "Onbekende waarde voor de instelling voor de productpaginaknop: %s."

#. translators: 1: submitted value, 2: comma-separated list of valid methods
#: class/WC_Twoinc.php:2288
#, php-format
msgid "Unrecognised surcharge method: %1$s. Choose one of: %2$s."
msgstr "Onbekende toeslagmethode: %1$s. Kies een van: %2$s."

#: class/WC_Twoinc.php:2315
msgid "Select a surcharge tax treatment before enabling surcharges."
msgstr "Selecteer een btw-behandeling voor de toeslag voordat u toeslagen inschakelt."

#. translators: %s: comma-separated term days, e.g. "14, 30"
#: class/WC_Twoinc.php:2327
#, php-format
msgid "Clear or correct the surcharge limit of 0 on these terms before enabling a percentage surcharge: %s. A limit of 0 charges nothing at all; to charge nothing on a term, set its percentage and fixed fee to 0 and leave the limit empty."
msgstr "Wis of corrigeer het maximum van 0 voor de toeslag op deze termijnen voordat je een percentagetoeslag inschakelt: %s. Een maximum van 0 zorgt ervoor dat er helemaal niets in rekening wordt gebracht; om voor een termijn niets in rekening te brengen, stel je het percentage en het vaste bedrag in op 0 en laat je het maximum leeg."

#: class/WC_Twoinc.php:2349
msgid "Select a surcharge tax treatment — surcharges cannot be used without one."
msgstr "Selecteer een btw-behandeling voor de toeslag — toeslagen kunnen niet zonder worden gebruikt."

#: class/WC_Twoinc.php:2360
msgid "That surcharge tax treatment leaves the surcharge untaxed for every destination and is no longer available. Create a tax class with a 0% rate and select it as the surcharge tax class instead."
msgstr "Die btw-behandeling van de toeslag laat de toeslag onbelast voor elke bestemming en is niet meer beschikbaar. Maak in plaats daarvan een btw-klasse met een tarief van 0% aan en selecteer die als btw-klasse van de toeslag."

#: class/WC_Twoinc.php:2367
msgid "Surcharge tax treatment must be one of the offered modes."
msgstr "De btw-behandeling van de toeslag moet een van de aangeboden modi zijn."

#: class/WC_Twoinc.php:2386
msgid "Surcharge tax class must be one of the store's existing tax classes."
msgstr "De btw-klasse van de toeslag moet een van de bestaande btw-klassen van de winkel zijn."

#. translators: %s: store currency symbol, e.g. "€"
#: class/WC_Twoinc.php:2422
#, php-format
msgid "Enter a limit amount (in %s) if you do not want to charge your customer more than a specific amount. Leave the limit field empty if you don't want to impose a limit amount."
msgstr "Vul een limietbedrag (in %s) in als je je klant niet meer dan een specifiek bedrag in rekening wilt brengen. Laat het limietveld leeg als je geen limietbedrag wilt instellen."

#: class/WC_Twoinc.php:2428
msgid "A limit of 0 is not allowed. To charge nothing on a term, set the percentage and the fixed fee for that term to 0 instead."
msgstr "Een maximum van 0 is niet toegestaan. Als je voor een termijn niets in rekening wilt brengen, stel dan het percentage en het vaste bedrag van die termijn in op 0."

#: class/WC_Twoinc.php:2432
msgid "The limit applies to the whole fee: the percentage and the fixed fee together, not the percentage alone."
msgstr "Het maximum geldt voor de hele vergoeding: het percentage en het vaste bedrag samen, niet alleen het percentage."

#: class/WC_Twoinc.php:2436
msgid "Enter the percentage of the fee's cost to you that you want the surcharge to recover. 100% means the fee no longer reduces your revenue at all."
msgstr "Vul het percentage in van de vergoedingskosten voor jou dat je met de toeslag wilt terugverdienen. 100% betekent dat de vergoeding je omzet niet langer verlaagt."

#: class/WC_Twoinc.php:2438
msgid "Enter the amount you want to charge your customer."
msgstr "Vul het bedrag in dat je bij je klant in rekening wilt brengen."

#. translators: %s: maximum fixed amount with currency, e.g. "EUR 25"
#: class/WC_Twoinc.php:2442
#, php-format
msgid "Max %s."
msgstr "Max %s."

#: class/WC_Twoinc.php:2447
msgid "Enter the amount and percentage of the fee charged to you that you want to offset with a surcharge. Max 100%."
msgstr "Vul het bedrag en percentage in van de vergoeding die aan jou in rekening wordt gebracht en die je wilt compenseren met een toeslag. Max 100%."

#: class/WC_Twoinc.php:2470
msgid "No payment terms are offered yet — configure the offered terms above first."
msgstr "Er worden nog geen betalingstermijnen aangeboden — stel eerst hierboven de aangeboden termijnen in."

#: class/WC_Twoinc.php:2473
msgid "Term (days)"
msgstr "Termijn (dagen)"

#: class/WC_Twoinc.php:2474
msgid "Fixed"
msgstr "Vast"

#: class/WC_Twoinc.php:2475
msgid "Percent of fee"
msgstr "Percentage van de vergoeding"

#: class/WC_Twoinc.php:2476
msgid "Limit"
msgstr "Maximum"

#. translators: %s: store currency code, e.g. "EUR"
#: class/WC_Twoinc.php:2495
#, php-format
msgid "Amounts are shown in %s."
msgstr "Bedragen worden getoond in %s."

#: class/WC_Twoinc.php:2515
msgid "fixed fee"
msgstr "vast bedrag"

#: class/WC_Twoinc.php:2516
msgid "percentage"
msgstr "percentage"

#: class/WC_Twoinc.php:2517
msgid "limit"
msgstr "limiet"

#. translators: 1: grid column name, already translated; 2: term days
#: class/WC_Twoinc.php:2596
#, php-format
msgid "Surcharge %1$s for the %2$s-day term must be a non-negative number."
msgstr "Toeslag %1$s voor de termijn van %2$s dagen moet een niet-negatief getal zijn."

#. translators: %s: term days
#: class/WC_Twoinc.php:2604
#, php-format
msgid "Surcharge percentage for the %s-day term must be between 0 and 100."
msgstr "Toeslagpercentage voor de termijn van %s dagen moet tussen 0 en 100 liggen."

#. translators: %s: term days
#: class/WC_Twoinc.php:2630
#, php-format
msgid "Surcharge limit for the %s-day term cannot be 0. To charge nothing on this term, set the percentage and the fixed fee to 0 instead, and leave the limit empty."
msgstr "Het maximum voor de toeslag voor de termijn van %s dagen mag niet 0 zijn. Als je voor deze termijn niets in rekening wilt brengen, stel dan het percentage en het vaste bedrag in op 0 en laat het maximum leeg."

#. translators: 1: term days, 2: maximum amount with currency
#: class/WC_Twoinc.php:2637
#, php-format
msgid "Surcharge fixed amount for the %1$s-day term exceeds the maximum of %2$s."
msgstr "Vast toeslagbedrag voor de termijn van %1$s dagen overschrijdt het maximum van %2$s."

#: class/WC_Twoinc.php:2826
msgid "Select at least one payment term or enter a custom term."
msgstr "Selecteer ten minste één betalingstermijn of voer een aangepaste termijn in."

#. translators: %s is the stored number of days.
#: class/WC_Twoinc.php:2854
#, php-format
msgid "Legacy setting. This offers a custom term of %s days after the end of the month. It is no longer supported and cannot be edited. Choose Remove to withdraw it, or use the payment terms above to change what you offer."
msgstr "Verouderde instelling. Dit biedt een aangepaste termijn van %s dagen na het einde van de maand. Deze wordt niet langer ondersteund en kan niet worden gewijzigd. Kies Verwijderen om deze in te trekken, of gebruik de betalingstermijnen hierboven om te wijzigen wat u aanbiedt."

#. translators: %s is the stored number of days.
