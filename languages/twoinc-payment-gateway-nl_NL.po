msgstr "Two"

#: class/WC_Twoinc.php:88
msgid "Place order"
msgstr "Bestelling plaatsen"

#: class/WC_Twoinc.php:90
msgid "Making it easy for businesses to buy online."
msgstr "Maak het voor bedrijven gemakkelijk om online te kopen."

#: class/WC_Twoinc.php:230
msgid "Production"
msgstr "Productie"

#: class/WC_Twoinc.php:231
msgid "Sandbox"
msgstr "Sandbox"

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:921
#, php-format
msgid "The %s payment method stays available; buyers are offered no payment term to choose from until one can be read."
msgstr "De betaalmethode %s blijft beschikbaar; kopers krijgen geen betaalvoorwaarden om uit te kiezen totdat er één gelezen kan worden."

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:927
#, php-format
msgid "Payment terms were last read successfully on %s."
msgstr "De betaalvoorwaarden zijn voor het laatst met succes gelezen op %s."

#: class/WC_Twoinc.php:930
msgid "Payment terms have never been read successfully on this site."
msgstr "De betaalvoorwaarden zijn op deze site nog nooit met succes gelezen."

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:937
#, php-format
msgid "The last attempt was on %s."
msgstr "De laatste poging was op %s."

#: class/WC_Twoinc.php:943
msgid "No attempt has been made yet."
msgstr "Er is nog geen poging gedaan."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:950
#, php-format
msgid "Check the \"%s API key\" and \"Environment\" settings."
msgstr "Controleer de instellingen \"%s API-sleutel\" en \"Omgeving\"."

#: class/WC_Twoinc.php:956
msgid "The plugin retries by itself; \"Refresh merchant profile\" under Diagnostics retries now."
msgstr "De plugin probeert het vanzelf opnieuw; \"Verkopersprofiel vernieuwen\" onder Diagnostiek probeert het nu opnieuw."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:968
#, php-format
msgid "No API key is saved, so your payment terms cannot be read from %s."
msgstr "Er is geen API-sleutel opgeslagen, dus je betaalvoorwaarden kunnen niet uit %s worden gelezen."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:971
#, php-format
msgid "Your %s account currently offers no payment terms."
msgstr "Je %s-account biedt momenteel geen betaalvoorwaarden aan."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:974
#, php-format
msgid "Your %s account returned no list of payment terms."
msgstr "Je %s-account heeft geen lijst met betaalvoorwaarden geretourneerd."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:977
#, php-format
msgid "Your payment terms have not been read from %s yet."
msgstr "Je betaalvoorwaarden zijn nog niet uit %s gelezen."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:983
#, php-format
msgid "Your payment terms could not be read: %s could not be reached (network failure or timeout)."
msgstr "Je betaalvoorwaarden konden niet worden gelezen: %s kon niet worden bereikt (netwerkfout of time-out)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:986
#, php-format
msgid "Your payment terms could not be read: %1$s rejected the saved API key (HTTP %2$d)."
msgstr "Je betaalvoorwaarden konden niet worden gelezen: %1$s heeft de opgeslagen API-sleutel geweigerd (HTTP %2$d)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:989
#, php-format
msgid "Your payment terms could not be read: %1$s refused the request as too frequent (HTTP %2$d)."
msgstr "Je betaalvoorwaarden konden niet worden gelezen: %1$s heeft het verzoek geweigerd omdat het te vaak werd gedaan (HTTP %2$d)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:992
#, php-format
msgid "Your payment terms could not be read: %1$s reported a server error (HTTP %2$d)."
msgstr "Je betaalvoorwaarden konden niet worden gelezen: %1$s heeft een serverfout gemeld (HTTP %2$d)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:995
#, php-format
msgid "Your payment terms could not be read: %1$s answered HTTP %2$d."
msgstr "Je betaalvoorwaarden konden niet worden gelezen: %1$s antwoordde HTTP %2$d."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:999
#, php-format
msgid "Your payment terms could not be read: the answer from %s could not be understood."
msgstr "Je betaalvoorwaarden konden niet worden gelezen: het antwoord van %s kon niet worden begrepen."

#: class/WC_Twoinc.php:1013
msgid "Never"
msgstr "Nooit"

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:1022
#, php-format
msgid "%s — the last attempt to refresh these figures failed; use \"Refresh merchant profile\" under Diagnostics to retry"
msgstr "%s — de laatste poging om deze cijfers te vernieuwen is mislukt; gebruik \"Verkopersprofiel vernieuwen\" onder Diagnostiek om het opnieuw te proberen"

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:1029
#, php-format
msgid "%s — these figures are out of date; use \"Refresh merchant profile\" under Diagnostics"
msgstr "%s — deze cijfers zijn verouderd; gebruik \"Verkopersprofiel vernieuwen\" onder Diagnostiek"

#: class/WC_Twoinc.php:1051
msgid "Payment method at checkout"
msgstr "Betaalmethode in de checkout"

#. translators: prefix of a reason the payment method is absent from checkout
#: class/WC_Twoinc.php:1053
msgid "Not shown at checkout"
msgstr "Niet zichtbaar in de checkout"

#: class/WC_Twoinc.php:1057
msgid "the payment method is disabled. Check \"Turn on/off\"."
msgstr "de betaalmethode is uitgeschakeld. Controleer \"Aan/uitzetten\"."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1061
#, php-format
msgid "no API key is saved. Check \"%s API key\"."
msgstr "er is geen API-sleutel opgeslagen. Controleer \"%s API-sleutel\"."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1070
#, php-format
msgid "the API key was rejected. Check \"%s API key\" and \"Environment\"."
msgstr "de API-sleutel is geweigerd. Controleer \"%s API-sleutel\" en \"Omgeving\"."

#: class/WC_Twoinc.php:1079
msgid "the saved surcharge method is not recognised. Check \"Surcharge method\"."
msgstr "de opgeslagen toeslagmethode wordt niet herkend. Controleer \"Toeslagmethode\"."

#. translators: %s is the brand provider's full name
#: class/WC_Twoinc.php:1088
#, php-format
msgid "the buyer countries on your account could not be read. Contact %s."
msgstr "de landen van de koper op uw account konden niet worden gelezen. Neem contact op met %s."

#. translators: %s is the brand provider's full name
#: class/WC_Twoinc.php:1093
#, php-format
msgid "no buyer countries are currently enabled for your account. Contact %s to have them enabled."
msgstr "er zijn momenteel geen landen van de koper geactiveerd voor uw account. Neem contact op met %s om ze te laten activeren."

#: class/WC_Twoinc.php:1111
msgid "Shown at checkout"
msgstr "Zichtbaar in de checkout"

#. translators: %s is a comma-separated list of ISO country codes
#: class/WC_Twoinc.php:1121
#, php-format
msgid "offered only to buyers in %s"
msgstr "alleen aangeboden aan kopers in %s"

#: class/WC_Twoinc.php:1127
msgid "minimum order value not known until your profile refreshes"
msgstr "minimumbestelwaarde nog niet bekend totdat uw profiel is vernieuwd"

#. translators: %s is an amount with its currency, e.g. "250.00 EUR (excluding tax)"
#: class/WC_Twoinc.php:1137
#, php-format
msgid "hidden for baskets below %s"
msgstr "verborgen voor winkelwagens onder %s"

#. translators: %1$s and %2$s are amounts with their currencies
#: class/WC_Twoinc.php:1142
#, php-format
msgid "hidden for baskets below %1$s or %2$s"
msgstr "verborgen voor winkelwagens onder %1$s of %2$s"

#: class/WC_Twoinc.php:1149
msgid "hidden for baskets in a currency the buyer surcharge cannot be priced in"
msgstr "verborgen voor winkelwagens in een valuta waarin de toeslag voor de koper niet kan worden berekend"

#. translators: %s is a comma-separated list of ISO country codes
#: class/WC_Twoinc.php:1174
#, php-format
msgid "offered only to buyers billed in %s"
msgstr "alleen aangeboden aan kopers die worden gefactureerd in %s"

#: class/WC_Twoinc.php:1208
msgid "excluding tax"
msgstr "exclusief btw"

#: class/WC_Twoinc.php:1209
msgid "including tax"
msgstr "inclusief btw"

#. translators: %d is a count of payment terms
#: class/WC_Twoinc.php:1220
#, php-format
msgid "Resolved (%d available)"
msgstr "Opgelost (%d beschikbaar)"

#. translators: %d is a count of payment terms
#: class/WC_Twoinc.php:1225
#, php-format
msgid "Resolved (%d available), last refresh failed"
msgstr "Opgelost (%d beschikbaar), laatste verversing mislukt"

#. translators: %d is a count of payment terms
#: class/WC_Twoinc.php:1227
#, php-format
msgid "Resolved (%d available), out of date"
msgstr "Opgelost (%d beschikbaar), verouderd"

#: class/WC_Twoinc.php:1229
msgid "No API key saved"
msgstr "Geen API-sleutel opgeslagen"

#: class/WC_Twoinc.php:1231
msgid "None offered by the account"
msgstr "Geen aangeboden door het account"

#: class/WC_Twoinc.php:1233
msgid "Not returned by the account"
msgstr "Niet geretourneerd door het account"

#: class/WC_Twoinc.php:1235
msgid "Not read yet"
msgstr "Nog niet gelezen"

#. translators: %d is an HTTP status code
#: class/WC_Twoinc.php:1241
#, php-format
msgid "Could not be read (HTTP %d)"
msgstr "Kon niet worden gelezen (HTTP %d)"

#: class/WC_Twoinc.php:1242
msgid "Could not be read"
msgstr "Kon niet worden gelezen"

#: class/WC_Twoinc.php:1466
#, php-format
msgid "What is %s?"
msgstr "Wat is %s ?"

#: class/WC_Twoinc.php:1473
#, php-format
msgid "%s is a payment solution for B2B purchases online, allowing you to buy from your favourite merchants and suppliers on trade credit. Using %s, you can access flexible trade credit instantly to make purchasing simple."
msgstr "%s is een betaaloplossing voor B2B-aankopen online, waarmee u bij uw favoriete handelaren en leveranciers op handelskrediet kunt kopen. Met %s krijgt u direct toegang tot flexibel handelskrediet om aankopen eenvoudig te maken."

#: class/WC_Twoinc.php:1474 class/WC_Twoinc_Product_Promo.php:127
msgid "Buy now, receive your goods, pay your invoice later."
msgstr "Koop nu, ontvang uw goederen, betaal uw factuur later."

#: class/WC_Twoinc.php:1476
msgid "Click to find out more"
msgstr "Klik om meer te weten te komen"

#. translators: shown beside the spinner while the order-intent availability check runs.
#: class/WC_Twoinc.php:1540
msgid "Checking availability"
msgstr "Beschikbaarheid controleren"

#. translators: %1$s: brand product name (e.g. "Two"); %2$s: the buyer's captured company name and number, substituted client-side — reorderable, do not assume %1$s precedes %2$s in every locale
#: class/WC_Twoinc.php:1655
#, php-format
msgid "This order by %2$s is likely to be accepted by %1$s"
msgstr "Deze bestelling van %2$s wordt waarschijnlijk geaccepteerd door %1$s"

#: class/WC_Twoinc.php:1664
#, php-format
msgid "Your invoice with %1$s is likely to be accepted, subject to additional checks."
msgstr "Uw factuur met %1$s wordt waarschijnlijk geaccepteerd, mits er aanvullende controles worden uitgevoerd."

#: class/WC_Twoinc.php:1700 class/WC_Twoinc.php:5473 class/WC_Twoinc.php:5483
#: class/WC_Twoinc.php:5591 class/WC_Twoinc_Helper.php:248
#, php-format
msgid "Invoice purchase with %s is not available for this order."
msgstr "Aankoop op factuur met %s is niet beschikbaar voor deze bestelling."

#. translators: %1$s: brand product name (e.g. "Two"); %2$s: the buyer's captured company name and number, substituted client-side
#: class/WC_Twoinc.php:1716
#, php-format
msgid "%1$s is not available for this order by %2$s"
msgstr "%1$s is niet beschikbaar voor deze bestelling van %2$s"

#: class/WC_Twoinc.php:1804
msgid "Phone number is invalid."
msgstr "Telefoonnummer is ongeldig."

#: class/WC_Twoinc.php:1805
msgid "We could not complete that just now. Please wait a moment and try again."
msgstr "Dit kon niet worden voltooid. Probeer het zo weer opnieuw."

#: class/WC_Twoinc.php:1809
#, php-format
msgid "To pay with %s, search for your company name and select it from the results."
msgstr "Om met %s te betalen, zoek je bedrijfsnaam op en selecteer deze uit de resultaten."

#: class/WC_Twoinc.php:1827 class/WC_Twoinc.php:1847 class/WC_Twoinc.php:2886
#: class/WC_Twoinc.php:4181 class/WC_Twoinc_Checkout.php:673
#, php-format
msgid "%s days"
msgstr "%s dagen"

#: class/WC_Twoinc.php:1844 class/WC_Twoinc.php:4183
msgid "Automatic"
msgstr "Automatisch"

#: class/WC_Twoinc.php:1892
msgid "Rounding step must be one of the offered values."
msgstr "Afrondingsstap moet een van de aangeboden waarden zijn."

#: class/WC_Twoinc.php:1910
msgid "— select a tax class —"
msgstr "— selecteer een btw-klasse —"

#: class/WC_Twoinc.php:1995
msgid "-- Select surcharge tax treatment --"
msgstr "-- Selecteer BTW-behandeling voor toeslag --"

#: class/WC_Twoinc.php:1996
msgid "Standard (store default tax rules)"
msgstr "Standaard (standaard btw-regels van de winkel)"

#: class/WC_Twoinc.php:1997
msgid "Specific tax class"
msgstr "Specifieke btw-klasse"

#: class/WC_Twoinc.php:1998
msgid "Never taxed"
msgstr "Nooit belast"

#: class/WC_Twoinc.php:2041
msgid "⚠ This store is set to leave the surcharge UNTAXED for every destination. That treatment is no longer available and these settings cannot be saved while it is stored — select a tax treatment above. To keep the fee untaxed, create a tax class with a 0% rate under WooCommerce → Settings → Tax and select it as the surcharge tax class."
msgstr "⚠ Deze winkel is ingesteld om de toeslag ONBELAST te laten voor elke bestemming. Die behandeling is niet meer beschikbaar en deze instellingen kunnen niet worden opgeslagen zolang die is opgeslagen — selecteer hierboven een btw-behandeling. Wilt u de vergoeding onbelast houden, maak dan een btw-klasse met een tarief van 0% aan onder WooCommerce → Instellingen → Btw en selecteer die als btw-klasse van de toeslag."

#: class/WC_Twoinc.php:2064
#, php-format
msgid "⚠ The previously selected tax class (\"%s\") no longer exists. The surcharge is currently taxed under the Standard treatment — select an existing tax class or change the tax treatment above."
msgstr "⚠ De eerder geselecteerde btw-klasse (\"%s\") bestaat niet meer. De toeslag wordt momenteel belast volgens de Standaard-behandeling — selecteer een bestaande btw-klasse of wijzig hierboven de btw-behandeling."

#. translators: %s: submitted value
#: class/WC_Twoinc.php:2193
#, php-format
msgid "Unrecognised value for the product page message switch: %s."
msgstr "Onbekende waarde voor de instelling voor het productpaginabericht: %s."

#. translators: %s: the type of the submitted value
#: class/WC_Twoinc.php:2218
#, php-format
msgid "Product page message accepts text only; a %s was submitted."
msgstr "Het productpaginabericht accepteert alleen tekst; er is een %s verzonden."

#. translators: %s: submitted value
#: class/WC_Twoinc.php:2252
#, php-format
msgid "Unrecognised value for the product page button switch: %s."
msgstr "Onbekende waarde voor de instelling voor de productpaginaknop: %s."

#. translators: 1: submitted value, 2: comma-separated list of valid methods
#: class/WC_Twoinc.php:2270
#, php-format
msgid "Unrecognised surcharge method: %1$s. Choose one of: %2$s."
msgstr "Onbekende toeslagmethode: %1$s. Kies een van: %2$s."

#: class/WC_Twoinc.php:2297
msgid "Select a surcharge tax treatment before enabling surcharges."
msgstr "Selecteer een btw-behandeling voor de toeslag voordat u toeslagen inschakelt."

#. translators: %s: comma-separated term days, e.g. "14, 30"
#: class/WC_Twoinc.php:2309
#, php-format
msgid "Clear or correct the surcharge limit of 0 on these terms before enabling a percentage surcharge: %s. A limit of 0 charges nothing at all; to charge nothing on a term, set its percentage and fixed fee to 0 and leave the limit empty."
msgstr "Wis of corrigeer het maximum van 0 voor de toeslag op deze termijnen voordat je een percentagetoeslag inschakelt: %s. Een maximum van 0 zorgt ervoor dat er helemaal niets in rekening wordt gebracht; om voor een termijn niets in rekening te brengen, stel je het percentage en het vaste bedrag in op 0 en laat je het maximum leeg."

#: class/WC_Twoinc.php:2331
msgid "Select a surcharge tax treatment — surcharges cannot be used without one."
msgstr "Selecteer een btw-behandeling voor de toeslag — toeslagen kunnen niet zonder worden gebruikt."

#: class/WC_Twoinc.php:2342
msgid "That surcharge tax treatment leaves the surcharge untaxed for every destination and is no longer available. Create a tax class with a 0% rate and select it as the surcharge tax class instead."
msgstr "Die btw-behandeling van de toeslag laat de toeslag onbelast voor elke bestemming en is niet meer beschikbaar. Maak in plaats daarvan een btw-klasse met een tarief van 0% aan en selecteer die als btw-klasse van de toeslag."

#: class/WC_Twoinc.php:2349
msgid "Surcharge tax treatment must be one of the offered modes."
msgstr "De btw-behandeling van de toeslag moet een van de aangeboden modi zijn."

#: class/WC_Twoinc.php:2368
msgid "Surcharge tax class must be one of the store's existing tax classes."
msgstr "De btw-klasse van de toeslag moet een van de bestaande btw-klassen van de winkel zijn."

#: class/WC_Twoinc.php:2381
msgid "Default shipping tax class must be one of the store's existing tax classes."
msgstr "De standaard btw-klasse voor verzending moet een van de bestaande btw-klassen van de winkel zijn."

#. translators: %s: store currency symbol, e.g. "€"
#: class/WC_Twoinc.php:2417
#, php-format
msgid "Enter a limit amount (in %s) if you do not want to charge your customer more than a specific amount. Leave the limit field empty if you don't want to impose a limit amount."
msgstr "Vul een limietbedrag (in %s) in als je je klant niet meer dan een specifiek bedrag in rekening wilt brengen. Laat het limietveld leeg als je geen limietbedrag wilt instellen."

#: class/WC_Twoinc.php:2423
msgid "A limit of 0 is not allowed. To charge nothing on a term, set the percentage and the fixed fee for that term to 0 instead."
msgstr "Een maximum van 0 is niet toegestaan. Als je voor een termijn niets in rekening wilt brengen, stel dan het percentage en het vaste bedrag van die termijn in op 0."

#: class/WC_Twoinc.php:2427
msgid "The limit applies to the whole fee: the percentage and the fixed fee together, not the percentage alone."
msgstr "Het maximum geldt voor de hele vergoeding: het percentage en het vaste bedrag samen, niet alleen het percentage."

#: class/WC_Twoinc.php:2431
msgid "Enter the percentage of the fee's cost to you that you want the surcharge to recover. 100% means the fee no longer reduces your revenue at all."
msgstr "Vul het percentage in van de vergoedingskosten voor jou dat je met de toeslag wilt terugverdienen. 100% betekent dat de vergoeding je omzet niet langer verlaagt."

#: class/WC_Twoinc.php:2433
msgid "Enter the amount you want to charge your customer."
msgstr "Vul het bedrag in dat je bij je klant in rekening wilt brengen."

#. translators: %s: maximum fixed amount with currency, e.g. "EUR 25"
#: class/WC_Twoinc.php:2437
#, php-format
msgid "Max %s."
msgstr "Max %s."

#: class/WC_Twoinc.php:2442
msgid "Enter the amount and percentage of the fee charged to you that you want to offset with a surcharge. Max 100%."
msgstr "Vul het bedrag en percentage in van de vergoeding die aan jou in rekening wordt gebracht en die je wilt compenseren met een toeslag. Max 100%."

#: class/WC_Twoinc.php:2465
msgid "No payment terms are offered yet — configure the offered terms above first."
msgstr "Er worden nog geen betalingstermijnen aangeboden — stel eerst hierboven de aangeboden termijnen in."

#: class/WC_Twoinc.php:2468
msgid "Term (days)"
msgstr "Termijn (dagen)"

#: class/WC_Twoinc.php:2469
msgid "Fixed"
msgstr "Vast"

#: class/WC_Twoinc.php:2470
msgid "Percent of fee"
msgstr "Percentage van de vergoeding"

#: class/WC_Twoinc.php:2471
msgid "Limit"
msgstr "Maximum"

#. translators: %s: store currency code, e.g. "EUR"
#: class/WC_Twoinc.php:2490
#, php-format
msgid "Amounts are shown in %s."
msgstr "Bedragen worden getoond in %s."

#: class/WC_Twoinc.php:2510
msgid "fixed fee"
msgstr "vast bedrag"

#: class/WC_Twoinc.php:2511
msgid "percentage"
msgstr "percentage"

#: class/WC_Twoinc.php:2512
msgid "limit"
msgstr "limiet"

#. translators: 1: grid column name, already translated; 2: term days
#: class/WC_Twoinc.php:2591
#, php-format
msgid "Surcharge %1$s for the %2$s-day term must be a non-negative number."
msgstr "Toeslag %1$s voor de termijn van %2$s dagen moet een niet-negatief getal zijn."

#. translators: %s: term days
#: class/WC_Twoinc.php:2599
#, php-format
msgid "Surcharge percentage for the %s-day term must be between 0 and 100."
msgstr "Toeslagpercentage voor de termijn van %s dagen moet tussen 0 en 100 liggen."

#. translators: %s: term days
#: class/WC_Twoinc.php:2625
#, php-format
msgid "Surcharge limit for the %s-day term cannot be 0. To charge nothing on this term, set the percentage and the fixed fee to 0 instead, and leave the limit empty."
msgstr "Het maximum voor de toeslag voor de termijn van %s dagen mag niet 0 zijn. Als je voor deze termijn niets in rekening wilt brengen, stel dan het percentage en het vaste bedrag in op 0 en laat het maximum leeg."

#. translators: 1: term days, 2: maximum amount with currency
#: class/WC_Twoinc.php:2632
#, php-format
msgid "Surcharge fixed amount for the %1$s-day term exceeds the maximum of %2$s."
msgstr "Vast toeslagbedrag voor de termijn van %1$s dagen overschrijdt het maximum van %2$s."

#: class/WC_Twoinc.php:2821
msgid "Select at least one payment term or enter a custom term."
msgstr "Selecteer ten minste één betalingstermijn of voer een aangepaste termijn in."

#. translators: %s is the stored number of days.
#: class/WC_Twoinc.php:2849
