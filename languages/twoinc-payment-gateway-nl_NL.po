msgstr "Uitgeschakeld"

#: class/WC_Twoinc.php:7206
msgid "Enabled"
msgstr "Ingeschakeld"

#: class/WC_Twoinc.php:7210
msgid "PHP curl extension"
msgstr "PHP curl-extensie"

#: class/WC_Twoinc.php:7211
msgid "Present"
msgstr "Aanwezig"

#: class/WC_Twoinc.php:7211
msgid "Missing"
msgstr "Ontbreekt"

#: class/WC_Twoinc.php:7220
msgid "Merchant profile last read"
msgstr "Verkopersprofiel laatst gelezen"

#: class/WC_Twoinc.php:7244
msgid "SSL verification is disabled while the environment is not production-hardened; re-check the \"Disable SSL verification\" setting."
msgstr "SSL-verificatie is uitgeschakeld terwijl de omgeving niet productiegehard is; controleer de instelling \"SSL-verificatie uitschakelen\" opnieuw."

#: class/WC_Twoinc.php:7261 class/WC_Twoinc.php:7291
msgid "Unable to retrieve the order information."
msgstr "De bestelgegevens kunnen niet worden opgehaald."

#: class/WC_Twoinc.php:7297
msgid "Unable to retrieve the order payment information"
msgstr "Kan de betalingsinformatie van de bestelling niet ophalen"

#: class/WC_Twoinc.php:7303
msgid "Missing company ID."
msgstr "Bedrijfs-ID ontbreekt."

#: class/WC_Twoinc.php:7389
#, php-format
msgid "Could not update the order with %s. Reason: %s"
msgstr "Kon de bestelling niet bijwerken met %s. Reden: %s"

#: class/WC_Twoinc.php:7437
