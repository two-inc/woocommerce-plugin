msgstr "Opgelost (%d beschikbaar)"

#. translators: %d is a count of payment terms
#: class/WC_Twoinc.php:1228
#, php-format
msgid "Resolved (%d available), last refresh failed"
msgstr "Opgelost (%d beschikbaar), laatste verversing mislukt"

#. translators: %d is a count of payment terms
#: class/WC_Twoinc.php:1230
#, php-format
msgid "Resolved (%d available), out of date"
msgstr "Opgelost (%d beschikbaar), verouderd"

#: class/WC_Twoinc.php:1232
msgid "No API key saved"
msgstr "Geen API-sleutel opgeslagen"

#: class/WC_Twoinc.php:1234
msgid "None offered by the account"
msgstr "Geen aangeboden door het account"

#: class/WC_Twoinc.php:1236
