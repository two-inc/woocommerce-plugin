msgstr "Of het winkelmandje met het minimum wordt vergeleken inclusief of exclusief btw."

#: class/WC_Twoinc.php:4587
msgid "Pre-approve buyer during checkout"
msgstr "Koper vooraf goedkeuren tijdens het afrekenen"

#: class/WC_Twoinc.php:4588
