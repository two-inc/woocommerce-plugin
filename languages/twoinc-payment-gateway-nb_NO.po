#: class/WC_Twoinc.php:1677
#, php-format
msgid "What is %s?"
msgstr "Hva er %s ?"

#: class/WC_Twoinc.php:1684
#, php-format
msgid "%s is a payment solution for B2B purchases online, allowing you to buy from your favourite merchants and suppliers on trade credit. Using %s, you can access flexible trade credit instantly to make purchasing simple."
msgstr "%s er en betalingsløsning for B2B-kjøp på nettet, som lar deg kjøpe fra dine favorittforhandlere og leverandører på handelskreditt. Ved å bruke %s kan du få tilgang til fleksibel handelskreditt umiddelbart for å gjøre kjøp enkelt."

#: class/WC_Twoinc.php:1685 class/WC_Twoinc_Product_Promo.php:127
msgid "Buy now, receive your goods, pay your invoice later."
msgstr "Kjøp nå, motta varene dine, betal fakturaen senere."

#: class/WC_Twoinc.php:1687
