msgid "Merchant profile"
msgstr "Selgerprofil"

#: class/WC_Twoinc.php:6875
msgid "Merchant ID:"
msgstr "Selger-ID:"

#: class/WC_Twoinc.php:6879
#, php-format
msgid "Don't have an API key? Get one by signing up <a href='%s'>here</a>."
msgstr "Har du ikke en API-nøkkel? Skaff deg en ved å registrere deg <a href='%s'>her</a> ."

#: class/WC_Twoinc.php:6927
msgid "Header name"
msgstr "Headernavn"

#: class/WC_Twoinc.php:6928
msgid "Value"
msgstr "Verdi"

#: class/WC_Twoinc.php:6929
msgid "Also send from browser"
msgstr "Send også fra nettleseren"

#: class/WC_Twoinc.php:6944 class/WC_Twoinc.php:6950
msgid "This entry contains characters this field cannot hold, so it is not shown and is not being sent. Enter it again."
msgstr "Denne oppføringen inneholder tegn dette feltet ikke kan holde, så den vises ikke og sendes ikke. Skriv den inn på nytt."

#: class/WC_Twoinc.php:6953
msgid "This row is not being sent, and the settings cannot be saved until it is corrected or removed."
msgstr "Denne raden sendes ikke, og innstillingene kan ikke lagres før den er rettet eller fjernet."

#: class/WC_Twoinc.php:6962
msgid "Add header"
msgstr "Legg til header"

#: class/WC_Twoinc.php:6964
msgid "Tick \"Also send from browser\" only if your IT administrator requires the header on calls from the buyer's browser as well as those from your server. Its value will be published to the buyer's browser and may be read by anyone."
msgstr "Kryss av for \"Send også fra nettleseren\" bare hvis IT-administratoren din krever headeren på kall fra kjøperens nettleser i tillegg til dem fra serveren din. Verdien vil bli publisert til kjøperens nettleser og kan leses av hvem som helst."

#: class/WC_Twoinc.php:6994
msgid "Every custom request header needs a name."
msgstr "Hvert egendefinerte forespørselsheader må ha et navn."

#. translators: %s: the rejected header name
#: class/WC_Twoinc.php:6999
#, php-format
msgid "\"%s\" is not a valid HTTP header name. Use letters, digits and hyphens."
msgstr "\"%s\" er ikke et gyldig HTTP-headernavn. Bruk bokstaver, tall og bindestrek."

#. translators: %s: the rejected header name
#: class/WC_Twoinc.php:7007
#, php-format
msgid "The header \"%s\" is reserved and cannot be set from this table."
msgstr "Headeren \"%s\" er reservert og kan ikke settes fra denne tabellen."

#. translators: %s: the header name whose value was rejected
#: class/WC_Twoinc.php:7014
#, php-format
msgid "The value of \"%s\" must be printable ASCII text and cannot be blank."
msgstr "Verdien til \"%s\" må være skrivbar ASCII-tekst og kan ikke være tom."

#. translators: %s: the duplicated header name
#: class/WC_Twoinc.php:7021
#, php-format
msgid "The header \"%s\" is listed more than once."
msgstr "Headeren \"%s\" er oppført mer enn én gang."

#: class/WC_Twoinc.php:7099
msgid "Select image"
msgstr "Velg bilde"

#: class/WC_Twoinc.php:7122
msgid "View error log"
msgstr "Vis feillogg"

#: class/WC_Twoinc.php:7125
msgid "Opens the WooCommerce log viewer filtered to this plugin's log entries."
msgstr "Åpner WooCommerce-loggviseren filtrert til denne tilleggsmodulens loggoppføringer."

#: class/WC_Twoinc.php:7160
msgid "Refresh merchant profile"
msgstr "Oppdater selgerprofil"

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:7166
#, php-format
msgid "Your offerable payment terms, buyer-surcharge cap, minimum order value and default term are read from %s and cached. They are refreshed every night and whenever the API key or environment is saved; use this to pull a change through now. The nightly refresh runs on WP-Cron. With WP-Cron disabled, the next request more than 24 hours after the last refresh re-reads it, and while a re-read keeps failing one request a minute retries it."
msgstr "Betalingsvilkårene du kan tilby, taket for kjøpstillegget, minste ordreverdi og standardvilkåret hentes fra %s og mellomlagres. De oppdateres hver natt og hver gang API-nøkkelen eller miljøet lagres; bruk denne for å hente inn en endring nå. Den nattlige oppdateringen kjører på WP-Cron. Med WP-Cron avslått leser den første forespørselen mer enn 24 timer etter forrige oppdatering den på nytt, og så lenge en ny lesing fortsetter å feile, prøver én forespørsel per minutt på nytt."

