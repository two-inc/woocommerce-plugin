#: class/WC_Twoinc.php:1227
#, php-format
msgid "Resolved (%d available), out of date"
msgstr "Løst (%d tilgjengelig), utdatert"

#: class/WC_Twoinc.php:1229
msgid "No API key saved"
msgstr "Ingen API-nøkkel lagret"

#: class/WC_Twoinc.php:1231
msgid "None offered by the account"
msgstr "Ingen tilbys av kontoen"

#: class/WC_Twoinc.php:1233
msgid "Not returned by the account"
msgstr "Ikke returnert av kontoen"

#: class/WC_Twoinc.php:1235
msgid "Not read yet"
msgstr "Ikke lest ennå"

#. translators: %d is an HTTP status code
#: class/WC_Twoinc.php:1241
#, php-format
