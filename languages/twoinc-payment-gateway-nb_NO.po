msgid "Buyer's address does not match a tax rate (no tax charged, e.g. exports)"
msgstr "Kjøperens adresse samsvarer ikke med noen avgiftssats (ingen avgift, f.eks. eksport)"

#. translators: %1$s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1147
#, php-format
msgid "%1$s rejected the stored API key; check \"%1$s API key\"."
msgstr "%1$s avviste den lagrede API-nøkkelen; sjekk \"%1$s API-nøkkel\"."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$s an HTTP status or "-"
#: class/WC_Twoinc.php:1149
#, php-format
msgid "Could not read your merchant details from %1$s (HTTP %2$s); try again in a few minutes."
msgstr "Kunne ikke lese forhandleropplysningene dine fra %1$s (HTTP %2$s); prøv igjen om noen minutter."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$s a country name, %3$s an HTTP status or "-"
#: class/WC_Twoinc.php:1154
#, php-format
msgid "Could not check whether %1$s requires tax codes for your country (%2$s, HTTP %3$s); try again in a few minutes."
msgstr "Kunne ikke sjekke om %1$s krever avgiftskoder for landet ditt (%2$s, HTTP %3$s); prøv igjen om noen minutter."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1189
#, php-format
msgid "Saved tax codes can't be read, so %s is hidden at checkout; clear them to restore it."
msgstr "De lagrede avgiftskodene kan ikke leses, så %s vises ikke i kassen; tøm dem for å få det tilbake."

#: class/WC_Twoinc.php:1190
msgid "Checkout has not picked up your merchant details; press \"Refresh merchant profile\" under Diagnostics."
msgstr "Kassen har ikke hentet forhandleropplysningene dine; trykk \"Oppdater forhandlerprofil\" under Diagnostikk."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$s a country name
#: class/WC_Twoinc.php:1192
#, php-format
msgid "Saved tax codes still apply at checkout, though %1$s does not require them for your country (%2$s)."
msgstr "Lagrede avgiftskoder gjelder fortsatt i kassen, selv om %1$s ikke krever dem for landet ditt (%2$s)."

#. translators: %1$s is a country name, %2$s the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1194
#, php-format
msgid "Some saved tax codes are not valid on 0%% lines for your country (%1$s), so %2$s refuses orders that use them."
msgstr "Noen lagrede avgiftskoder er ikke gyldige på linjer med 0 %% for landet ditt (%1$s), så %2$s avviser bestillinger som bruker dem."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$s a country name
#: class/WC_Twoinc.php:1211
#, php-format
msgid "%1$s requires a tax code on every 0%% line for your country (%2$s): choose one for each case below. A case left on (none) sends no code, and %1$s refuses the line. Shipping with no tax class of its own takes the code the order's other 0%% lines share. Northern Ireland counts as EU for goods only: in a services class's EU column, don't choose an intra-community services code."
msgstr "%1$s krever en avgiftskode på hver linje med 0 %% for landet ditt (%2$s): velg én for hvert tilfelle nedenfor. Et tilfelle som står på (ingen) sender ingen kode, og %1$s avviser linjen. Frakt uten egen avgiftsklasse får koden de andre linjene med 0 %% i bestillingen deler. Nord-Irland regnes som EU bare for varer: i EU-kolonnen for en tjenesteklasse må du ikke velge en kode for tjenester innenfor EU."

#: class/WC_Twoinc.php:1218
msgid "Clear saved tax codes"
msgstr "Tøm lagrede avgiftskoder"

#: class/WC_Twoinc.php:1256
msgid "(none)"
msgstr "(ingen)"

#: class/WC_Twoinc.php:1259
msgid "not valid on 0% lines"
msgstr "ikke gyldig på linjer med 0 %"

#: class/WC_Twoinc.php:1259
msgid "no longer listed"
msgstr "ikke lenger oppført"

#: class/WC_Twoinc.php:1278
msgid "Tax class"
msgstr "Avgiftsklasse"

#: class/WC_Twoinc.php:1295
msgid "No 0% tax rate in this class"
msgstr "Ingen avgiftssats på 0 % i denne klassen"

#. translators: %s is why the tax code section could not be read
#: class/WC_Twoinc.php:1337
#, php-format
msgid "The tax codes for 0%% lines were not saved, and your saved codes are unchanged: %s"
msgstr "Avgiftskodene for linjer med 0 %% ble ikke lagret, og de lagrede kodene er uendret: %s"

#: class/WC_Twoinc.php:1344
msgid "The tax codes for 0% lines arrived incomplete, so they were not saved and your saved codes are unchanged. Reload the page and try again."
msgstr "Avgiftskodene for linjer med 0 % kom ufullstendig fram, så de ble ikke lagret, og de lagrede kodene dine er uendret. Last inn siden på nytt og prøv igjen."

#. translators: %s is a tax code
#: class/WC_Twoinc.php:1362
#, php-format
msgid "The tax code %s is not offered for 0%% lines, so the tax codes were not saved and your saved codes are unchanged."
msgstr "Avgiftskoden %s tilbys ikke for linjer med 0 %%, så avgiftskodene ble ikke lagret, og de lagrede kodene er uendret."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1792
