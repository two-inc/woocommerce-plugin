msgstr "Valgfritt. Angi et egendefinert antall dager å tilby sammen med de valgte vilkårene ovenfor."

#: class/WC_Twoinc.php:4703
msgid "Default payment terms"
msgstr "Standard betalingsbetingelser"

#: class/WC_Twoinc.php:4704
