msgstr "Two"

#: class/WC_Twoinc.php:88
msgid "Place order"
msgstr "Realizar pedido"

#: class/WC_Twoinc.php:90
msgid "Making it easy for businesses to buy online."
msgstr "Facilitamos que las empresas compren en línea."

#: class/WC_Twoinc.php:230
msgid "Production"
msgstr "Producción"

#: class/WC_Twoinc.php:231
msgid "Sandbox"
msgstr "Entorno de pruebas"

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:921
#, php-format
msgid "The %s payment method stays available; buyers are offered no payment term to choose from until one can be read."
msgstr "El método de pago %s sigue disponible; no se ofrece a los compradores ningún plazo de pago para elegir hasta que se pueda leer alguno."

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:927
#, php-format
msgid "Payment terms were last read successfully on %s."
msgstr "Los plazos de pago se leyeron correctamente por última vez el %s."

#: class/WC_Twoinc.php:930
msgid "Payment terms have never been read successfully on this site."
msgstr "Los plazos de pago nunca se han leído correctamente en este sitio."

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:937
#, php-format
msgid "The last attempt was on %s."
msgstr "El último intento fue el %s."

#: class/WC_Twoinc.php:943
msgid "No attempt has been made yet."
msgstr "Todavía no se ha realizado ningún intento."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:950
#, php-format
msgid "Check the \"%s API key\" and \"Environment\" settings."
msgstr "Compruebe los ajustes \"Clave API de %s\" y \"Entorno\"."

#: class/WC_Twoinc.php:956
msgid "The plugin retries by itself; \"Refresh merchant profile\" under Diagnostics retries now."
msgstr "El plugin lo reintenta por sí solo; \\\"Actualizar perfil del comerciante\\\" en Diagnósticos lo reintenta ahora."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:968
#, php-format
msgid "No API key is saved, so your payment terms cannot be read from %s."
msgstr "No hay ninguna clave API guardada, por lo que tus plazos de pago no se pueden leer de %s."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:971
#, php-format
msgid "Your %s account currently offers no payment terms."
msgstr "Tu cuenta de %s no ofrece actualmente ningún plazo de pago."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:974
#, php-format
msgid "Your %s account returned no list of payment terms."
msgstr "Tu cuenta de %s no ha devuelto ninguna lista de plazos de pago."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:977
#, php-format
msgid "Your payment terms have not been read from %s yet."
msgstr "Tus plazos de pago aún no se han leído de %s."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:983
#, php-format
msgid "Your payment terms could not be read: %s could not be reached (network failure or timeout)."
msgstr "No se han podido leer tus plazos de pago: no se ha podido contactar con %s (fallo de red o tiempo de espera agotado)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:986
#, php-format
msgid "Your payment terms could not be read: %1$s rejected the saved API key (HTTP %2$d)."
msgstr "No se han podido leer tus plazos de pago: %1$s ha rechazado la clave API guardada (HTTP %2$d)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:989
#, php-format
msgid "Your payment terms could not be read: %1$s refused the request as too frequent (HTTP %2$d)."
msgstr "No se han podido leer tus plazos de pago: %1$s ha rechazado la petición por ser demasiado frecuente (HTTP %2$d)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:992
#, php-format
msgid "Your payment terms could not be read: %1$s reported a server error (HTTP %2$d)."
msgstr "No se han podido leer tus plazos de pago: %1$s ha informado de un error del servidor (HTTP %2$d)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:995
#, php-format
msgid "Your payment terms could not be read: %1$s answered HTTP %2$d."
msgstr "No se han podido leer tus plazos de pago: %1$s ha respondido HTTP %2$d."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:999
#, php-format
msgid "Your payment terms could not be read: the answer from %s could not be understood."
msgstr "No se han podido leer tus plazos de pago: no se ha podido interpretar la respuesta de %s."

#: class/WC_Twoinc.php:1013
msgid "Never"
msgstr "Nunca"

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:1022
#, php-format
msgid "%s — the last attempt to refresh these figures failed; use \"Refresh merchant profile\" under Diagnostics to retry"
msgstr "%s — el último intento de actualizar estas cifras ha fallado; usa \\\"Actualizar perfil de comerciante\\\" en Diagnóstico para reintentar"

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:1029
#, php-format
msgid "%s — these figures are out of date; use \"Refresh merchant profile\" under Diagnostics"
msgstr "%s — estas cifras están desactualizadas; usa \\\"Actualizar perfil de comerciante\\\" en Diagnóstico"

#: class/WC_Twoinc.php:1051
msgid "Payment method at checkout"
msgstr "Método de pago en la caja"

#. translators: prefix of a reason the payment method is absent from checkout
#: class/WC_Twoinc.php:1053
msgid "Not shown at checkout"
msgstr "No se muestra en la caja"

#: class/WC_Twoinc.php:1057
msgid "the payment method is disabled. Check \"Turn on/off\"."
msgstr "el método de pago está desactivado. Compruebe \"Turn on/off\"."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1061
#, php-format
msgid "no API key is saved. Check \"%s API key\"."
msgstr "no hay ninguna clave API guardada. Compruebe \"Clave API de %s\"."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1070
#, php-format
msgid "the API key was rejected. Check \"%s API key\" and \"Environment\"."
msgstr "la clave API fue rechazada. Compruebe \"Clave API de %s\" y \"Entorno\"."

#: class/WC_Twoinc.php:1079
msgid "the saved surcharge method is not recognised. Check \"Surcharge method\"."
msgstr "el método de recargo guardado no se reconoce. Compruebe \"Surcharge method\"."

#. translators: %s is the brand provider's full name
#: class/WC_Twoinc.php:1088
#, php-format
msgid "the buyer countries on your account could not be read. Contact %s."
msgstr "los países del comprador de su cuenta no se han podido leer. Póngase en contacto con %s."

#. translators: %s is the brand provider's full name
#: class/WC_Twoinc.php:1093
#, php-format
msgid "no buyer countries are currently enabled for your account. Contact %s to have them enabled."
msgstr "actualmente no hay ningún país de comprador activado para su cuenta. Póngase en contacto con %s para activarlos."

#: class/WC_Twoinc.php:1111
msgid "Shown at checkout"
msgstr "Se muestra en la caja"

#. translators: %s is a comma-separated list of ISO country codes
#: class/WC_Twoinc.php:1121
#, php-format
msgid "offered only to buyers in %s"
msgstr "se ofrece solo a compradores en %s"

#: class/WC_Twoinc.php:1127
msgid "minimum order value not known until your profile refreshes"
msgstr "el valor mínimo del pedido no se conoce hasta que su perfil se actualice"

#. translators: %s is an amount with its currency, e.g. "250.00 EUR (excluding tax)"
#: class/WC_Twoinc.php:1137
#, php-format
msgid "hidden for baskets below %s"
msgstr "oculto para cestas por debajo de %s"

#. translators: %1$s and %2$s are amounts with their currencies
#: class/WC_Twoinc.php:1142
#, php-format
msgid "hidden for baskets below %1$s or %2$s"
msgstr "oculto para cestas por debajo de %1$s o %2$s"

#: class/WC_Twoinc.php:1149
msgid "hidden for baskets in a currency the buyer surcharge cannot be priced in"
msgstr "oculto para cestas en una moneda en la que el recargo al comprador no puede calcularse"

#. translators: %s is a comma-separated list of ISO country codes
#: class/WC_Twoinc.php:1174
#, php-format
msgid "offered only to buyers billed in %s"
msgstr "se ofrece solo a compradores facturados en %s"

#: class/WC_Twoinc.php:1208
msgid "excluding tax"
msgstr "sin impuestos"

#: class/WC_Twoinc.php:1209
msgid "including tax"
msgstr "con impuestos"

#. translators: %d is a count of payment terms
#: class/WC_Twoinc.php:1220
#, php-format
msgid "Resolved (%d available)"
msgstr "Resuelto (%d disponibles)"

#. translators: %d is a count of payment terms
#: class/WC_Twoinc.php:1225
#, php-format
msgid "Resolved (%d available), last refresh failed"
msgstr "Resuelto (%d disponibles), la última actualización falló"

#. translators: %d is a count of payment terms
#: class/WC_Twoinc.php:1227
#, php-format
msgid "Resolved (%d available), out of date"
msgstr "Resuelto (%d disponibles), desactualizado"

#: class/WC_Twoinc.php:1229
msgid "No API key saved"
msgstr "Ninguna clave API guardada"

#: class/WC_Twoinc.php:1231
msgid "None offered by the account"
msgstr "Ninguno ofrecido por la cuenta"

#: class/WC_Twoinc.php:1233
msgid "Not returned by the account"
msgstr "No devuelto por la cuenta"

#: class/WC_Twoinc.php:1235
msgid "Not read yet"
msgstr "Aún no leído"

#. translators: %d is an HTTP status code
#: class/WC_Twoinc.php:1241
#, php-format
msgid "Could not be read (HTTP %d)"
msgstr "No se ha podido leer (HTTP %d)"

#: class/WC_Twoinc.php:1242
msgid "Could not be read"
msgstr "No se ha podido leer"

#: class/WC_Twoinc.php:1466
#, php-format
msgid "What is %s?"
msgstr "¿Qué es %s?"

#: class/WC_Twoinc.php:1473
#, php-format
msgid "%s is a payment solution for B2B purchases online, allowing you to buy from your favourite merchants and suppliers on trade credit. Using %s, you can access flexible trade credit instantly to make purchasing simple."
msgstr "%s es una solución de pago para compras B2B en línea, que le permite comprar a sus comerciantes y proveedores favoritos con crédito comercial. Con %s, puede acceder al instante a crédito comercial flexible para simplificar sus compras."

#: class/WC_Twoinc.php:1474 class/WC_Twoinc_Product_Promo.php:203
msgid "Buy now, receive your goods, pay your invoice later."
msgstr "Compre ahora, reciba sus productos y pague su factura más tarde."

#: class/WC_Twoinc.php:1476
msgid "Click to find out more"
msgstr "Haga clic para saber más"

#. translators: shown beside the spinner while the order-intent availability check runs.
#: class/WC_Twoinc.php:1540
msgid "Checking availability"
msgstr "Comprobando disponibilidad"

#. translators: %1$s: brand product name (e.g. "Two"); %2$s: the buyer's captured company name and number, substituted client-side — reorderable, do not assume %1$s precedes %2$s in every locale
#: class/WC_Twoinc.php:1655
#, php-format
msgid "This order by %2$s is likely to be accepted by %1$s"
msgstr "Es probable que %1$s acepte este pedido de %2$s"

#: class/WC_Twoinc.php:1664
#, php-format
msgid "Your invoice with %1$s is likely to be accepted, subject to additional checks."
msgstr "Es probable que tu factura con %1$s sea aceptada, sujeta a comprobaciones adicionales."

#: class/WC_Twoinc.php:1700 class/WC_Twoinc.php:5442 class/WC_Twoinc.php:5452
#: class/WC_Twoinc.php:5560 class/WC_Twoinc_Helper.php:248
#, php-format
msgid "Invoice purchase with %s is not available for this order."
msgstr "La compra con factura mediante %s no está disponible para este pedido."

#. translators: %1$s: brand product name (e.g. "Two"); %2$s: the buyer's captured company name and number, substituted client-side
#: class/WC_Twoinc.php:1716
#, php-format
msgid "%1$s is not available for this order by %2$s"
msgstr "%1$s no está disponible para este pedido de %2$s"

#: class/WC_Twoinc.php:1804
msgid "Phone number is invalid."
msgstr "El número de teléfono no es válido."

#: class/WC_Twoinc.php:1805
msgid "We could not complete that just now. Please wait a moment and try again."
msgstr "No se pudo completar esto en este momento. Espere un momento y vuelva a intentarlo."

#: class/WC_Twoinc.php:1809
#, php-format
msgid "To pay with %s, search for your company name and select it from the results."
msgstr "Para pagar con %s, busca el nombre de tu empresa y selecciónalo entre los resultados."

#: class/WC_Twoinc.php:1827 class/WC_Twoinc.php:1847 class/WC_Twoinc.php:2855
#: class/WC_Twoinc.php:4150 class/WC_Twoinc_Checkout.php:673
#, php-format
msgid "%s days"
msgstr "%s días"

#: class/WC_Twoinc.php:1844 class/WC_Twoinc.php:4152
msgid "Automatic"
msgstr "Automático"

#: class/WC_Twoinc.php:1892
msgid "Rounding step must be one of the offered values."
msgstr "El paso de redondeo debe ser uno de los valores ofrecidos."

#: class/WC_Twoinc.php:1910
msgid "— select a tax class —"
msgstr "— selecciona una clase de impuesto —"

#: class/WC_Twoinc.php:1995
msgid "-- Select surcharge tax treatment --"
msgstr "-- Selecciona el tratamiento fiscal del recargo --"

#: class/WC_Twoinc.php:1996
msgid "Standard (store default tax rules)"
msgstr "Estándar (reglas de impuestos predeterminadas de la tienda)"

#: class/WC_Twoinc.php:1997
msgid "Specific tax class"
msgstr "Clase de impuestos específica"

#: class/WC_Twoinc.php:1998
msgid "Never taxed"
msgstr "Nunca gravado"

#: class/WC_Twoinc.php:2041
msgid "⚠ This store is set to leave the surcharge UNTAXED for every destination. That treatment is no longer available and these settings cannot be saved while it is stored — select a tax treatment above. To keep the fee untaxed, create a tax class with a 0% rate under WooCommerce → Settings → Tax and select it as the surcharge tax class."
msgstr "⚠ Esta tienda está configurada para dejar el recargo SIN IMPUESTOS para todos los destinos. Ese tratamiento ya no está disponible y estos ajustes no se pueden guardar mientras esté almacenado — selecciona un tratamiento fiscal más arriba. Para mantener la tarifa sin impuestos, crea una clase de impuesto con un tipo del 0% en WooCommerce → Settings → Tax y selecciónala como clase de impuesto del recargo."

#: class/WC_Twoinc.php:2064
#, php-format
msgid "⚠ The previously selected tax class (\"%s\") no longer exists. The surcharge is currently taxed under the Standard treatment — select an existing tax class or change the tax treatment above."
msgstr "⚠ La clase de impuesto seleccionada anteriormente (\\\"%s\\\") ya no existe. El recargo se grava actualmente con el tratamiento Estándar — selecciona una clase de impuesto existente o cambia el tratamiento fiscal más arriba."

#. translators: %s: submitted value
#: class/WC_Twoinc.php:2193
#, php-format
msgid "Unrecognised value for the product page message switch: %s."
msgstr "Valor no reconocido para la opción de mensaje en la página de producto: %s."

#. translators: %s: the type of the submitted value
#: class/WC_Twoinc.php:2218
#, php-format
msgid "Product page message accepts text only; a %s was submitted."
msgstr "El mensaje de la página de producto solo acepta texto; se ha enviado un %s."

#. translators: 1: submitted value, 2: comma-separated list of valid methods
#: class/WC_Twoinc.php:2239
#, php-format
msgid "Unrecognised surcharge method: %1$s. Choose one of: %2$s."
msgstr "Método de recargo no reconocido: %1$s. Elija uno de: %2$s."

#: class/WC_Twoinc.php:2266
msgid "Select a surcharge tax treatment before enabling surcharges."
msgstr "Selecciona un tratamiento fiscal del recargo antes de activar los recargos."

#. translators: %s: comma-separated term days, e.g. "14, 30"
#: class/WC_Twoinc.php:2278
#, php-format
msgid "Clear or correct the surcharge limit of 0 on these terms before enabling a percentage surcharge: %s. A limit of 0 charges nothing at all; to charge nothing on a term, set its percentage and fixed fee to 0 and leave the limit empty."
msgstr "Borra o corrige el límite de recargo de 0 en estos plazos antes de habilitar un recargo porcentual: %s. Un límite de 0 no cobra nada en absoluto; para no cobrar nada en un plazo, establece su porcentaje y su cuota fija en 0 y deja el límite vacío."

#: class/WC_Twoinc.php:2300
msgid "Select a surcharge tax treatment — surcharges cannot be used without one."
msgstr "Selecciona un tratamiento fiscal del recargo — los recargos no se pueden usar sin uno."

#: class/WC_Twoinc.php:2311
msgid "That surcharge tax treatment leaves the surcharge untaxed for every destination and is no longer available. Create a tax class with a 0% rate and select it as the surcharge tax class instead."
msgstr "Ese tratamiento fiscal del recargo deja el recargo sin impuestos para todos los destinos y ya no está disponible. Crea una clase de impuesto con un tipo del 0% y selecciónala como clase de impuesto del recargo."

#: class/WC_Twoinc.php:2318
msgid "Surcharge tax treatment must be one of the offered modes."
msgstr "El tratamiento fiscal del recargo debe ser uno de los modos ofrecidos."

#: class/WC_Twoinc.php:2337
msgid "Surcharge tax class must be one of the store's existing tax classes."
msgstr "La clase de impuestos del recargo debe ser una de las clases de impuestos existentes de la tienda."

#: class/WC_Twoinc.php:2350
msgid "Default shipping tax class must be one of the store's existing tax classes."
msgstr "La clase de impuesto de envío predeterminada debe ser una de las clases de impuesto existentes en la tienda."

#. translators: %s: store currency symbol, e.g. "€"
#: class/WC_Twoinc.php:2386
#, php-format
msgid "Enter a limit amount (in %s) if you do not want to charge your customer more than a specific amount. Leave the limit field empty if you don't want to impose a limit amount."
msgstr "Introduce un importe límite (en %s) si no quieres cobrar a tu cliente más de una cantidad concreta. Deja el campo de límite vacío si no quieres imponer un importe límite."

#: class/WC_Twoinc.php:2392
msgid "A limit of 0 is not allowed. To charge nothing on a term, set the percentage and the fixed fee for that term to 0 instead."
msgstr "No se permite un límite de 0. Para no cobrar nada en un plazo, establece el porcentaje y la tarifa fija de ese plazo en 0."

#: class/WC_Twoinc.php:2396
msgid "The limit applies to the whole fee: the percentage and the fixed fee together, not the percentage alone."
msgstr "El límite se aplica a la comisión completa: el porcentaje y la comisión fija juntos, no solo al porcentaje."

#: class/WC_Twoinc.php:2400
msgid "Enter the percentage of the fee's cost to you that you want the surcharge to recover. 100% means the fee no longer reduces your revenue at all."
msgstr "Introduce el porcentaje del coste de la comisión que quieres recuperar con el recargo. 100% significa que la comisión ya no reduce tus ingresos en absoluto."

#: class/WC_Twoinc.php:2402
msgid "Enter the amount you want to charge your customer."
msgstr "Introduce el importe que quieres cobrar a tu cliente."

#. translators: %s: maximum fixed amount with currency, e.g. "EUR 25"
#: class/WC_Twoinc.php:2406
#, php-format
msgid "Max %s."
msgstr "Máx. %s."

#: class/WC_Twoinc.php:2411
msgid "Enter the amount and percentage of the fee charged to you that you want to offset with a surcharge. Max 100%."
msgstr "Introduce el importe y el porcentaje de la comisión que se te cobra y que quieres compensar con un recargo. Máx. 100%."

#: class/WC_Twoinc.php:2434
msgid "No payment terms are offered yet — configure the offered terms above first."
msgstr "Todavía no se ofrece ningún plazo de pago — configura primero los plazos ofrecidos arriba."

#: class/WC_Twoinc.php:2437
msgid "Term (days)"
msgstr "Plazo (días)"

#: class/WC_Twoinc.php:2438
msgid "Fixed"
msgstr "Fijo"

#: class/WC_Twoinc.php:2439
msgid "Percent of fee"
msgstr "Porcentaje de la comisión"

#: class/WC_Twoinc.php:2440
msgid "Limit"
msgstr "Límite"

#. translators: %s: store currency code, e.g. "EUR"
#: class/WC_Twoinc.php:2459
#, php-format
msgid "Amounts are shown in %s."
msgstr "Los importes se muestran en %s."

#: class/WC_Twoinc.php:2479
msgid "fixed fee"
msgstr "tarifa fija"

#: class/WC_Twoinc.php:2480
msgid "percentage"
msgstr "porcentaje"

#: class/WC_Twoinc.php:2481
msgid "limit"
msgstr "límite"

#. translators: 1: grid column name, already translated; 2: term days
#: class/WC_Twoinc.php:2560
#, php-format
msgid "Surcharge %1$s for the %2$s-day term must be a non-negative number."
msgstr "El recargo %1$s para el plazo de %2$s días debe ser un número no negativo."

#. translators: %s: term days
#: class/WC_Twoinc.php:2568
#, php-format
msgid "Surcharge percentage for the %s-day term must be between 0 and 100."
msgstr "El porcentaje de recargo para el plazo de %s días debe estar entre 0 y 100."

#. translators: %s: term days
#: class/WC_Twoinc.php:2594
#, php-format
msgid "Surcharge limit for the %s-day term cannot be 0. To charge nothing on this term, set the percentage and the fixed fee to 0 instead, and leave the limit empty."
msgstr "El límite del recargo para el plazo de %s días no puede ser 0. Para no cobrar nada en este plazo, establece el porcentaje y la tarifa fija en 0 y deja el límite vacío."

#. translators: 1: term days, 2: maximum amount with currency
#: class/WC_Twoinc.php:2601
#, php-format
msgid "Surcharge fixed amount for the %1$s-day term exceeds the maximum of %2$s."
msgstr "El importe fijo del recargo para el plazo de %1$s días supera el máximo de %2$s."

#: class/WC_Twoinc.php:2790
msgid "Select at least one payment term or enter a custom term."
msgstr "Selecciona al menos un plazo de pago o introduce un plazo personalizado."

#. translators: %s is the stored number of days.
#: class/WC_Twoinc.php:2818
#, php-format
msgid "Legacy setting. This offers a custom term of %s days after the end of the month. It is no longer supported and cannot be edited. Choose Remove to withdraw it, or use the payment terms above to change what you offer."
msgstr "Ajuste heredado. Ofrece un plazo personalizado de %s días tras el fin de mes. Ya no es compatible y no se puede editar. Elige Eliminar para retirarlo, o usa los plazos de pago de arriba para cambiar lo que ofreces."

#. translators: %s is the stored number of days.
#: class/WC_Twoinc.php:2825
#, php-format
msgid "Legacy setting. This offers a custom term of %s days from fulfilment. It is no longer supported and cannot be edited. Choose Remove to withdraw it, or use the payment terms above to change what you offer."
msgstr "Ajuste heredado. Ofrece un plazo personalizado de %s días desde el cumplimiento. Ya no es compatible y no se puede editar. Elige Eliminar para retirarlo, o usa los plazos de pago de arriba para cambiar lo que ofreces."

