#: class/WC_Twoinc_Checkout.php:379
msgid "We use your company name to automatically populate your address and register the company that made the purchase."
msgstr "Utilizamos el nombre de su empresa para rellenar automáticamente su dirección y registrar la empresa que realizó la compra."

#: class/WC_Twoinc_Checkout.php:383
msgid "Company search is temporarily unavailable. Please try again."
msgstr "La búsqueda de empresas no está disponible temporalmente. Inténtelo de nuevo."

#. translators: %d: minimum number of characters the buyer must type before the company search runs. Left unresolved here and interpolated in JS from the threshold the widget enforces, so the two cannot disagree.
#: class/WC_Twoinc_Checkout.php:391
#, php-format
msgid "Enter %d or more characters"
msgstr "Introduzca %d o más caracteres"

#: class/WC_Twoinc_Checkout.php:398
msgid "Enter manually"
msgstr "Introducir manualmente"

#: class/WC_Twoinc_Checkout.php:399
msgid "Search for company"
msgstr "Buscar empresa"

#: class/WC_Twoinc_Checkout.php:469
msgid "Registered company"
msgstr "Empresa registrada"

#: class/WC_Twoinc_Checkout.php:470
msgid "Sole trader"
msgstr "Autónomo"

#: class/WC_Twoinc_Checkout.php:471
msgid "Click here to login or sign up as a sole trader."
msgstr "Haga clic aquí para iniciar sesión o registrarse como autónomo."

#: class/WC_Twoinc_Checkout.php:477
msgid "Select a different sole trader"
msgstr "Seleccionar otro autónomo"

#: class/WC_Twoinc_Checkout.php:478
msgid "Something went wrong setting up sole trader checkout. Please try again."
msgstr "Se produjo un error al configurar el pago como autónomo. Inténtelo de nuevo."

#. translators: shown beside the spinner while the order-intent availability check runs.
#: class/WC_Twoinc.php:935
msgid "Checking availability"
msgstr "Comprobando disponibilidad"

#: class/WC_Twoinc.php:1151
msgid "We could not complete that just now. Please wait a moment and try again."
msgstr "No se pudo completar esto en este momento. Espere un momento y vuelva a intentarlo."

#: class/WC_Twoinc.php:4042
#, php-format
msgid "Please select your company before paying with %s."
msgstr "Seleccione su empresa antes de pagar con %s."

#. translators: 1: submitted value, 2: comma-separated list of valid methods
#: class/WC_Twoinc.php
#, php-format
msgid "Unrecognised surcharge method: %1$s. Choose one of: %2$s."
msgstr "Método de recargo no reconocido: %1$s. Elija uno de: %2$s."

#: class/WC_Twoinc.php
#, php-format
msgid "The last attempt was on %s."
msgstr "El último intento fue el %s."

#: class/WC_Twoinc.php
msgid "No attempt has been made yet."
msgstr "Todavía no se ha realizado ningún intento."

#: class/WC_Twoinc.php
msgid "Check the API key and Environment settings above."
msgstr "Compruebe los ajustes Clave API y Entorno anteriores."

#: class/WC_Twoinc.php
msgid "Payment method at checkout"
msgstr "Método de pago en la caja"

#: class/WC_Twoinc.php
msgid "Not shown at checkout"
msgstr "No se muestra en la caja"

#: class/WC_Twoinc.php
msgid "the payment method is disabled. Check Enable/Disable."
msgstr "el método de pago está desactivado. Compruebe Activar/Desactivar."

#: class/WC_Twoinc.php
msgid "no API key is saved. Check API key."
msgstr "no hay ninguna clave API guardada. Compruebe Clave API."

#: class/WC_Twoinc.php
msgid "the API key was rejected. Check API key and Environment."
msgstr "la clave API fue rechazada. Compruebe Clave API y Entorno."

#: class/WC_Twoinc.php
msgid "Cannot be checked — the API key could not be verified just now."
msgstr "No se puede comprobar: la clave API no se ha podido verificar en este momento."

#: class/WC_Twoinc.php
msgid "the buyer surcharge cannot be priced in the store currency. Check the surcharge settings."
msgstr "el recargo al comprador no puede calcularse en la moneda de la tienda. Compruebe los ajustes de recargo."

#: class/WC_Twoinc.php
msgid "your account allows no buyer countries. Contact us to have them enabled."
msgstr "su cuenta no permite ningún país de comprador. Póngase en contacto con nosotros para activarlos."

#: class/WC_Twoinc.php
msgid "Shown at checkout"
msgstr "Se muestra en la caja"

#: class/WC_Twoinc.php
#, php-format
msgid "hidden for baskets below %1$s %2$s (%3$s)"
msgstr "oculto para cestas por debajo de %1$s %2$s (%3$s)"
