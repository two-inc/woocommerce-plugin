#: class/WC_Twoinc.php:2293
#, php-format
msgid "What is %s?"
msgstr "Vad är %s ?"

#: class/WC_Twoinc.php:2300
#, php-format
msgid "%s is a payment solution for B2B purchases online, allowing you to buy from your favourite merchants and suppliers on trade credit. Using %s, you can access flexible trade credit instantly to make purchasing simple."
msgstr "%s är en betalningslösning för B2B-köp online, som låter dig köpa från dina favorithandlare och leverantörer på handelskredit. Genom att använda %s kan du få tillgång till flexibel handelskredit direkt för att göra inköp enkelt."

#: class/WC_Twoinc.php:2301 class/WC_Twoinc_Product_Promo.php:127
msgid "Buy now, receive your goods, pay your invoice later."
msgstr "Köp nu, ta emot dina varor, betala din faktura senare."

#: class/WC_Twoinc.php:2303
msgid "Click to find out more"
msgstr "Klicka för att läsa mer"

#. translators: shown beside the spinner while the order-intent availability check runs.
#: class/WC_Twoinc.php:2367
msgid "Checking availability"
msgstr "Kontrollerar tillgänglighet"

#. translators: %1$s: brand product name (e.g. "Two"); %2$s: the buyer's captured company name and number, substituted client-side — reorderable, do not assume %1$s precedes %2$s in every locale
#: class/WC_Twoinc.php:2482
#, php-format
msgid "This order by %2$s is likely to be accepted by %1$s"
msgstr "Denna order från %2$s kommer sannolikt att godkännas av %1$s"

#: class/WC_Twoinc.php:2491
#, php-format
msgid "Your invoice with %1$s is likely to be accepted, subject to additional checks."
msgstr "Din faktura med %1$s kommer sannolikt att accepteras, under förutsättning av ytterligare kontroller."

#: class/WC_Twoinc.php:2527 class/WC_Twoinc.php:6332 class/WC_Twoinc.php:6342
#: class/WC_Twoinc.php:6432 class/WC_Twoinc.php:6462
#: class/WC_Twoinc_Blocks_Support.php:85 class/WC_Twoinc_Helper.php:408
#, php-format
msgid "Invoice purchase with %s is not available for this order."
msgstr "Fakturaköp med %s är inte tillgängligt för denna beställning."

#. translators: %1$s: brand product name (e.g. "Two"); %2$s: the buyer's captured company name and number, substituted client-side
#: class/WC_Twoinc.php:2543
#, php-format
msgid "%1$s is not available for this order by %2$s"
msgstr "%1$s är inte tillgängligt för denna order från %2$s"

#: class/WC_Twoinc.php:2631
msgid "Phone number is invalid."
msgstr "Telefonnumret är ogiltigt"

#: class/WC_Twoinc.php:2632
msgid "We could not complete that just now. Please wait a moment and try again."
msgstr "Det gick inte att slutföra detta just nu. Vänta en stund och försök igen."

#: class/WC_Twoinc.php:2636
#, php-format
msgid "To pay with %s, search for your company name and select it from the results."
msgstr "För att betala med %s, sök upp ditt företagsnamn och välj det bland resultaten."

#: class/WC_Twoinc.php:2654 class/WC_Twoinc.php:2674 class/WC_Twoinc.php:3700
#: class/WC_Twoinc.php:5012 class/WC_Twoinc_Checkout.php:735
#, php-format
msgid "%s days"
msgstr "%s dagar"

#: class/WC_Twoinc.php:2671 class/WC_Twoinc.php:5014
msgid "Automatic"
msgstr "Automatiskt"

#: class/WC_Twoinc.php:2719
msgid "Rounding step must be one of the offered values."
msgstr "Avrundningssteget måste vara ett av de erbjudna värdena."

#: class/WC_Twoinc.php:2737
msgid "— select a tax class —"
msgstr "— välj en skatteklass —"

#: class/WC_Twoinc.php:2822
msgid "-- Select surcharge tax treatment --"
msgstr "-- Välj momshantering för tillägg --"

#: class/WC_Twoinc.php:2823
msgid "Standard (store default tax rules)"
msgstr "Standard (butikens standardskatteregler)"

#: class/WC_Twoinc.php:2824
msgid "Specific tax class"
msgstr "Specifik skatteklass"

#: class/WC_Twoinc.php:2825
msgid "Never taxed"
msgstr "Aldrig beskattad"

#: class/WC_Twoinc.php:2868
msgid "⚠ This store is set to leave the surcharge UNTAXED for every destination. That treatment is no longer available and these settings cannot be saved while it is stored — select a tax treatment above. To keep the fee untaxed, create a tax class with a 0% rate under WooCommerce → Settings → Tax and select it as the surcharge tax class."
msgstr "⚠ Denna butik är inställd på att lämna tillägget OBESKATTAT för alla destinationer. Den hanteringen är inte längre tillgänglig och dessa inställningar kan inte sparas så länge den är sparad — välj en skattehantering ovan. Om du vill hålla avgiften obeskattad skapar du en skatteklass med 0 %-sats under WooCommerce → Inställningar → Skatt och väljer den som skatteklass för tillägg."

#: class/WC_Twoinc.php:2891
#, php-format
msgid "⚠ The previously selected tax class (\"%s\") no longer exists. The surcharge is currently taxed under the Standard treatment — select an existing tax class or change the tax treatment above."
msgstr "⚠ Den tidigare valda skatteklassen (\"%s\") finns inte längre. Tillägget beskattas för närvarande enligt Standard-hanteringen — välj en befintlig skatteklass eller ändra skattehanteringen ovan."

#. translators: %s: submitted value
#: class/WC_Twoinc.php:3020
#, php-format
msgid "Unrecognised value for the product page message switch: %s."
msgstr "Okänt värde för inställningen för produktsidesmeddelandet: %s."

#. translators: %s: the type of the submitted value
#: class/WC_Twoinc.php:3045
#, php-format
msgid "Product page message accepts text only; a %s was submitted."
msgstr "Produktsidesmeddelandet accepterar endast text; en %s skickades in."

#. translators: %s: submitted value
#: class/WC_Twoinc.php:3079
#, php-format
msgid "Unrecognised value for the product page button switch: %s."
msgstr "Okänt värde för inställningen för produktsidesknappen: %s."

#. translators: 1: submitted value, 2: comma-separated list of valid methods
#: class/WC_Twoinc.php:3097
#, php-format
msgid "Unrecognised surcharge method: %1$s. Choose one of: %2$s."
msgstr "Okänd tilläggsmetod: %1$s. Välj en av: %2$s."

#: class/WC_Twoinc.php:3124
msgid "Select a surcharge tax treatment before enabling surcharges."
msgstr "Välj en skattehantering för tillägg innan du aktiverar tillägg."

#. translators: %s: comma-separated term days, e.g. "14, 30"
#: class/WC_Twoinc.php:3136
#, php-format
msgid "Clear or correct the surcharge limit of 0 on these terms before enabling a percentage surcharge: %s. A limit of 0 charges nothing at all; to charge nothing on a term, set its percentage and fixed fee to 0 and leave the limit empty."
msgstr "Rensa eller korrigera gränsen på 0 för tillägget på dessa terminer innan du aktiverar ett procenttillägg: %s. En gräns på 0 debiterar ingenting alls; för att inte debitera något för en termin sätter du procenten och den fasta avgiften till 0 och lämnar gränsen tom."

#: class/WC_Twoinc.php:3158
msgid "Select a surcharge tax treatment — surcharges cannot be used without one."
msgstr "Välj en skattehantering för tillägg — tillägg kan inte användas utan en."

