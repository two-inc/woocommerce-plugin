msgstr "%s har misslyckats med att utfärda faktura för order %s ."

#: class/WC_Twoinc.php:3325
#, php-format
msgid "%s has cancelled %d order."
msgid_plural "%s has cancelled %d orders."
msgstr[0] "%s har avbrutit %d beställning."
msgstr[1] "%s har avbrutit %d beställningar."

#: class/WC_Twoinc.php:3329
#, php-format
msgid "%s has failed to cancel order %s."
msgstr "%s har misslyckats med att avbryta beställning %s ."

#: class/WC_Twoinc.php:3417
