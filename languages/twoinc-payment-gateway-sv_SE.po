#: class/WC_Twoinc.php:1870
#, php-format
msgid "no API key is saved. Check \"%s API key\"."
msgstr "ingen API-nyckel är sparad. Kontrollera \"%s API-nyckel\"."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1879
#, php-format
msgid "the API key was rejected. Check \"%s API key\" and \"Environment\"."
msgstr "API-nyckeln avvisades. Kontrollera \"%s API-nyckel\" och \"Miljö\"."

#: class/WC_Twoinc.php:1885
msgid "the saved tax code mapping is unreadable. Use \"Clear saved tax codes\" under Tax."
msgstr "den sparade mappningen av momskoder kan inte läsas. Använd \"Rensa sparade momskoder\" under Skatt."

#: class/WC_Twoinc.php:1891
