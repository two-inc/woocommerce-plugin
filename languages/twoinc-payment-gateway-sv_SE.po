msgid "Standard"
msgstr "Standard"

#: class/WC_Twoinc.php:1054
msgid "VAT-registered buyer, other EU state"
msgstr "Momsregistrerad köpare, annan EU-stat"

#: class/WC_Twoinc.php:1056
msgid "Your 0% tax rates"
msgstr "Dina momssatser på 0 %"

#: class/WC_Twoinc.php:1058
msgid "Buyer's address does not match a tax rate (no tax charged, e.g. exports)"
msgstr "Köparens adress matchar ingen momssats (ingen moms, t.ex. export)"

#. translators: %1$s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1085
#, php-format
msgid "%1$s rejected the stored API key; check \"%1$s API key\"."
msgstr "%1$s avvisade den sparade API-nyckeln; kontrollera \"%1$s API-nyckel\"."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$s an HTTP status or "-"
#: class/WC_Twoinc.php:1087
#, php-format
msgid "Could not read your merchant details from %1$s (HTTP %2$s); try again in a few minutes."
msgstr "Det gick inte att läsa dina handlaruppgifter från %1$s (HTTP %2$s); försök igen om några minuter."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$s a country name, %3$s an HTTP status or "-"
#: class/WC_Twoinc.php:1092
#, php-format
msgid "Could not check whether %1$s requires tax codes for your country (%2$s, HTTP %3$s); try again in a few minutes."
msgstr "Det gick inte att kontrollera om %1$s kräver momskoder för ditt land (%2$s, HTTP %3$s); försök igen om några minuter."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1127
#, php-format
msgid "Saved tax codes can't be read, so %s is hidden at checkout; clear them to restore it."
msgstr "De sparade momskoderna kan inte läsas, så %s döljs i kassan; rensa dem för att återställa det."

#: class/WC_Twoinc.php:1128
msgid "Checkout has not picked up your merchant details; press \"Refresh merchant profile\" under Diagnostics."
msgstr "Kassan har inte hämtat dina handlaruppgifter; klicka på \"Uppdatera handlarprofil\" under Diagnostik."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$s a country name
#: class/WC_Twoinc.php:1130
#, php-format
msgid "Saved tax codes still apply at checkout, though %1$s does not require them for your country (%2$s)."
msgstr "Sparade momskoder gäller fortfarande i kassan, även om %1$s inte kräver dem för ditt land (%2$s)."

#. translators: %1$s is a country name, %2$s the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1132
#, php-format
msgid "Some saved tax codes are not valid on 0%% lines for your country (%1$s), so %2$s refuses orders that use them."
msgstr "Vissa sparade momskoder är inte giltiga på rader med 0 %% för ditt land (%1$s), så %2$s avvisar beställningar som använder dem."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$s a country name
#: class/WC_Twoinc.php:1149
#, php-format
msgid "%1$s requires a tax code on every 0%% line for your country (%2$s): choose one for each case below. A case left on (none) sends no code, and %1$s refuses the line. Shipping with no tax class of its own takes the code the order's other 0%% lines share. Northern Ireland counts as EU for goods only: in a services class's EU column, don't choose an intra-community services code."
msgstr "%1$s kräver en momskod på varje rad med 0 %% för ditt land (%2$s): välj en för varje fall nedan. Ett fall som står på (ingen) skickar ingen kod, och %1$s avvisar raden. Frakt utan egen momsklass får den kod som orderns övriga rader med 0 %% delar. Nordirland räknas som EU endast för varor: välj inte en kod för tjänster inom gemenskapen i EU-kolumnen för en tjänsteklass."

#: class/WC_Twoinc.php:1156
msgid "Clear saved tax codes"
msgstr "Rensa sparade momskoder"

#: class/WC_Twoinc.php:1194
msgid "(none)"
msgstr "(ingen)"

#: class/WC_Twoinc.php:1197
msgid "not valid on 0% lines"
msgstr "inte giltig på rader med 0 %"

#: class/WC_Twoinc.php:1197
msgid "no longer listed"
msgstr "finns inte längre i listan"

#: class/WC_Twoinc.php:1216
msgid "Tax class"
msgstr "Momsklass"

#: class/WC_Twoinc.php:1233
msgid "No 0% tax rate in this class"
msgstr "Ingen momssats på 0 % i den här klassen"

#. translators: %s is why the tax code section could not be read
#: class/WC_Twoinc.php:1275
#, php-format
msgid "The tax codes for 0%% lines were not saved, and your saved codes are unchanged: %s"
msgstr "Momskoderna för rader med 0 %% sparades inte och dina sparade koder är oförändrade: %s"

#: class/WC_Twoinc.php:1282
msgid "The tax codes for 0% lines arrived incomplete, so they were not saved and your saved codes are unchanged. Reload the page and try again."
msgstr "Momskoderna för rader med 0 % kom fram ofullständiga, så de sparades inte och dina sparade koder är oförändrade. Ladda om sidan och försök igen."

#. translators: %s is a tax code
#: class/WC_Twoinc.php:1300
#, php-format
msgid "The tax code %s is not offered for 0%% lines, so the tax codes were not saved and your saved codes are unchanged."
msgstr "Momskoden %s erbjuds inte för rader med 0 %%, så momskoderna sparades inte och dina sparade koder är oförändrade."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1730
#, php-format
msgid "The %s payment method stays available; buyers are offered no payment term to choose from until one can be read."
msgstr "Betalningsmetoden %s är fortfarande tillgänglig; köpare erbjuds inga betalningsvillkor att välja mellan förrän ett kan läsas."

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:1736
#, php-format
msgid "Payment terms were last read successfully on %s."
msgstr "Betalningsvillkoren lästes in korrekt senast %s."

#: class/WC_Twoinc.php:1739
msgid "Payment terms have never been read successfully on this site."
msgstr "Betalningsvillkoren har aldrig lästs in korrekt på den här webbplatsen."

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:1746
#, php-format
msgid "The last attempt was on %s."
msgstr "Senaste försöket var %s."

#: class/WC_Twoinc.php:1752
msgid "No attempt has been made yet."
msgstr "Inget försök har gjorts ännu."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1759
#, php-format
msgid "Check the \"%s API key\" and \"Environment\" settings."
msgstr "Kontrollera inställningarna \"%s API-nyckel\" och \"Miljö\"."

#: class/WC_Twoinc.php:1765
msgid "The plugin retries by itself; \"Refresh merchant profile\" under Diagnostics retries now."
msgstr "Pluginet försöker igen av sig självt; \"Uppdatera säljarprofil\" under Diagnostik försöker igen nu."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1777
#, php-format
msgid "No API key is saved, so your payment terms cannot be read from %s."
msgstr "Ingen API-nyckel är sparad, så dina betalningsvillkor kan inte läsas från %s."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1780
#, php-format
msgid "Your %s account currently offers no payment terms."
msgstr "Ditt %s-konto erbjuder för närvarande inga betalningsvillkor."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1783
#, php-format
msgid "Your %s account returned no list of payment terms."
msgstr "Ditt %s-konto returnerade ingen lista över betalningsvillkor."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1786
#, php-format
msgid "Your payment terms have not been read from %s yet."
msgstr "Dina betalningsvillkor har ännu inte lästs från %s."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1792
#, php-format
msgid "Your payment terms could not be read: %s could not be reached (network failure or timeout)."
msgstr "Dina betalningsvillkor kunde inte läsas: %s kunde inte nås (nätverksfel eller timeout)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:1795
#, php-format
msgid "Your payment terms could not be read: %1$s rejected the saved API key (HTTP %2$d)."
msgstr "Dina betalningsvillkor kunde inte läsas: %1$s avvisade den sparade API-nyckeln (HTTP %2$d)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:1798
#, php-format
msgid "Your payment terms could not be read: %1$s refused the request as too frequent (HTTP %2$d)."
msgstr "Dina betalningsvillkor kunde inte läsas: %1$s avvisade begäran som för frekvent (HTTP %2$d)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:1801
#, php-format
msgid "Your payment terms could not be read: %1$s reported a server error (HTTP %2$d)."
msgstr "Dina betalningsvillkor kunde inte läsas: %1$s rapporterade ett serverfel (HTTP %2$d)."

#. translators: %1$s is the brand product name (e.g. "Two"), %2$d an HTTP status code
#: class/WC_Twoinc.php:1804
#, php-format
msgid "Your payment terms could not be read: %1$s answered HTTP %2$d."
msgstr "Dina betalningsvillkor kunde inte läsas: %1$s svarade HTTP %2$d."

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:1808
#, php-format
msgid "Your payment terms could not be read: the answer from %s could not be understood."
msgstr "Dina betalningsvillkor kunde inte läsas: svaret från %s kunde inte tolkas."

#: class/WC_Twoinc.php:1822
msgid "Never"
msgstr "Aldrig"

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:1831
#, php-format
msgid "%s — the last attempt to refresh these figures failed; use \"Refresh merchant profile\" under Diagnostics to retry"
msgstr "%s — det senaste försöket att uppdatera dessa siffror misslyckades; använd \"Uppdatera säljarprofil\" under Diagnostik för att försöka igen"

#. translators: %s is a date and time in the site's own format
#: class/WC_Twoinc.php:1838
#, php-format
msgid "%s — these figures are out of date; use \"Refresh merchant profile\" under Diagnostics"
msgstr "%s — dessa siffror är inaktuella; använd \"Uppdatera säljarprofil\" under Diagnostik"

