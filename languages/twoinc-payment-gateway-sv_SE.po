msgid "Merchant profile"
msgstr "Säljarprofil"

#: class/WC_Twoinc.php:6293
msgid "Merchant ID:"
msgstr "Handlar-ID:"

#: class/WC_Twoinc.php:6297
#, php-format
msgid "Don't have an API key? Get one by signing up <a href='%s'>here</a>."
msgstr ""
"Har du ingen API-nyckel? Skaffa en genom att registrera dig <a "
"href='%s'>här</a> ."

#: class/WC_Twoinc.php:6345
msgid "Header name"
msgstr "Huvudnamn"

#: class/WC_Twoinc.php:6346
