msgid "Payment method at checkout"
msgstr "Betalningsmetod i kassan"

#. translators: prefix of a reason the payment method is absent from checkout
#: class/WC_Twoinc.php:1862
msgid "Not shown at checkout"
msgstr "Visas inte i kassan"

#: class/WC_Twoinc.php:1866
