msgstr "Orsak: Kunde inte hitta %s order-ID."

#: class/WC_Twoinc.php:3448
#, php-format
msgid "The tracking number could not be attached to the %s order. The invoice will be sent without it."
msgstr "Spårningsnummret kunde inte kopplas till %s-ordern. Fakturan skickas utan det."

#: class/WC_Twoinc.php:3458 class/WC_Twoinc.php:3470
#, php-format
msgid "Could not update order status to \"Fulfilled\" with %s."
msgstr "Kunde inte uppdatera orderstatus till \"Uppfylld\" med %s ."

#: class/WC_Twoinc.php:3462 class/WC_Twoinc.php:3474 class/WC_Twoinc.php:3529
#: class/WC_Twoinc.php:3537 class/WC_Twoinc.php:4303 class/WC_Twoinc.php:4316
#: class/WC_Twoinc.php:5226 class/WC_Twoinc.php:5368
#, php-format
msgid "Please contact %s support with order ID: %s"
msgstr "Vänligen kontakta %s support med order-ID: %s"

#: class/WC_Twoinc.php:3475 class/WC_Twoinc.php:3538 class/WC_Twoinc.php:4304
#: class/WC_Twoinc.php:5369
#, php-format
msgid "Response: %s"
msgstr "Svar: %s"

#: class/WC_Twoinc.php:3480
#, php-format
msgid "%s has acknowledged the request to fulfil the order. An invoice will be sent to the buyer when the fulfilment is complete."
msgstr "%s har bekräftat begäran om att fullgöra beställningen. En faktura skickas till köparen när fullgörandet är klart."

#: class/WC_Twoinc.php:3512 class/WC_Twoinc.php:3528 class/WC_Twoinc.php:3536
msgid "Could not update status to \"Cancelled\"."
msgstr "Kunde inte uppdatera status till \"Avbruten\"."

#: class/WC_Twoinc.php:3520
#, php-format
msgid "Order is already cancelled with %s."
msgstr "Beställningen är redan annullerad med %s ."

#: class/WC_Twoinc.php:3574
#, php-format
msgid "%s pre-filled fields"
msgstr "%s förifyllda fält"

#: class/WC_Twoinc.php:3578
msgid "Billing company name"
msgstr "Företagsnamn"

#: class/WC_Twoinc.php:3584
msgid "Billing company ID"
msgstr "Organisationsnummer"

#: class/WC_Twoinc.php:3590 class/WC_Twoinc_Checkout.php:277
msgid "Project"
msgstr "Projekt"

#: class/WC_Twoinc.php:3594
msgid "The project displayed on the invoices"
msgstr "Projektet som visas på fakturorna"

#: class/WC_Twoinc.php:3598 class/WC_Twoinc_Checkout.php:286
msgid "Department"
msgstr "Avdelning"

#: class/WC_Twoinc.php:3602
msgid "The department displayed on the invoices"
msgstr "Avdelningen som visas på fakturorna"

#: class/WC_Twoinc.php:3788 class/WC_Twoinc.php:3884 class/WC_Twoinc.php:4191
msgid "including"
msgstr "inklusive"

#: class/WC_Twoinc.php:3789 class/WC_Twoinc.php:3884 class/WC_Twoinc.php:4191
msgid "excluding"
msgstr "exklusive"

#: class/WC_Twoinc.php:3792
#, php-format
msgid "Platform minimum %1$s, %2$s tax. A value here is interpreted in the store currency on the tax basis selected below and must exceed it."
msgstr "Plattformsminimum %1$s, %2$s skatt. Ett värde här tolkas i butiksvalutan på det skatteunderlag som valts nedan och måste överstiga det."

#. translators: 1: platform minimum in its native currency, e.g. "EUR 250.00", 2: the same minimum converted into the store currency at the current FX rate, e.g. "NOK 2,941.18", 3: tax basis label, "including" or "excluding"
#: class/WC_Twoinc.php:3806
#, php-format
msgid "Platform minimum %1$s (approximately %2$s at the current exchange rate), %3$s tax. A value here is interpreted in the store currency on the tax basis selected below — both minimums are enforced independently."
msgstr "Plattformsminimum %1$s (ungefär %2$s till aktuell växelkurs), %3$s skatt. Ett värde här tolkas i butiksvalutan på det skatteunderlag som valts nedan — båda minimigränserna tillämpas oberoende av varandra."

#: class/WC_Twoinc.php:3813
#, php-format
msgid "Platform minimum %1$s, %2$s tax. A value here is interpreted in the store currency on the tax basis selected below; it cannot be checked against the platform minimum (different currency) — both minimums are enforced independently."
msgstr "Plattformsminimum %1$s, %2$s skatt. Ett värde här tolkas i butiksvalutan på det skatteunderlag som valts nedan; det kan inte kontrolleras mot plattformsminimumet (annan valuta) — båda minimigränserna tillämpas oberoende av varandra."

#: class/WC_Twoinc.php:3818
msgid "Hide the payment method below this order value (store currency, on the tax basis selected below). Leave empty for no minimum."
msgstr "Dölj betalningsmetoden under detta ordervärde (butiksvaluta, på det skatteunderlag som valts nedan). Lämna tomt för inget minimum."

#: class/WC_Twoinc.php:3873
msgid "Minimum order value must be a non-negative number."
msgstr "Minsta beställningsvärde måste vara ett icke-negativt tal."

#: class/WC_Twoinc.php:3882
#, php-format
msgid "Minimum order value must exceed the platform minimum of %1$s, %2$s tax."
msgstr "Minsta ordervärde måste överstiga plattformsminimumet på %1$s, %2$s skatt."

#. translators: %s is a comma-separated list of the rejected entries
#: class/WC_Twoinc.php:3914
#, php-format
msgid "Trusted proxy addresses: %s is not a valid IP address or CIDR block, and is ignored. Requests from it are not treated as coming from a trusted proxy."
msgstr "Betrodda proxyadresser: %s är inte en giltig IP-adress eller CIDR-block och ignoreras. Förfrågningar därifrån behandlas inte som om de kommer från en betrodd proxy."

#: class/WC_Twoinc.php:3979
msgid "The selected payment term is no longer available. Please review the payment options and place the order again."
msgstr "Det valda betalningsvillkoret är inte längre tillgängligt. Gå igenom betalningsalternativen och lägg ordern igen."

#: class/WC_Twoinc.php:4042
#, php-format
msgid "Please select your company before paying with %s."
msgstr "Välj ditt företag innan du betalar med %s."

#: class/WC_Twoinc.php:4152
#, php-format
msgid "Failed to request order creation with %s."
msgstr "Det gick inte att begära att beställningen skapades med %s ."

#: class/WC_Twoinc.php:4158
#, php-format
msgid "Failed to process payment with %s"
msgstr "Det gick inte att behandla betalningen med %s"

#: class/WC_Twoinc.php:4188
#, php-format
msgid "Minimum order value is %1$s%2$s %3$s tax."
msgstr "Minsta ordervärde är %1$s%2$s %3$s moms."

#: class/WC_Twoinc.php:4242 class/WC_Twoinc.php:4295 class/WC_Twoinc.php:4302
#: class/WC_Twoinc.php:4315
#, php-format
msgid "Failed to request order refund with %s."
msgstr "Det gick inte att begära återbetalning av beställningen med %s ."

#: class/WC_Twoinc.php:4247
#, php-format
msgid "Could not find %s order ID"
msgstr "Kunde inte hitta %s order-ID"

#: class/WC_Twoinc.php:4255
#, php-format
