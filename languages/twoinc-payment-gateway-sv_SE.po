#: class/WC_Twoinc.php:6861
msgid "Title"
msgstr "Titel"

#: class/WC_Twoinc.php:6868
msgid "Subtitle"
msgstr "Underrubrik"

#: class/WC_Twoinc.php:6870
msgid "Optional subtitle shown beneath the title at checkout."
msgstr "Valfri underrubrik som visas under titeln i kassan."

#: class/WC_Twoinc.php:6878
msgid "Show message on product pages"
msgstr "Visa meddelande på produktsidor"

#: class/WC_Twoinc.php:6879
msgid "Shows a short promotional line on product pages, beneath the add to cart button. Off by default. Where it lands depends on your theme."
msgstr "Visar en kort kampanjrad på produktsidor, under knappen för att lägga i varukorgen. Av som standard. Var den hamnar beror på ditt tema."

#: class/WC_Twoinc.php:6886
msgid "Product page message"
msgstr "Meddelande på produktsidan"

#: class/WC_Twoinc.php:6888
msgid "Optional. Empty uses the default wording. Avoid naming a number of days unless you are certain of the terms you offer: terms run from fulfilment, and the terms actually available come from your merchant record."
msgstr "Valfritt. Tomt fält använder standardtexten. Undvik att ange ett antal dagar om du inte är säker på de betalningsvillkor du erbjuder: villkoren löper från fullgörande och de villkor som faktiskt är tillgängliga kommer från din merchant-post."

#: class/WC_Twoinc.php:6895
msgid "Show buy button on product pages"
msgstr "Visa köpknapp på produktsidor"

#: class/WC_Twoinc.php:6896
msgid "Adds a button beside Add to cart that adds the item and opens checkout with this payment method already selected. It does not place the order. Off by default. Where it lands depends on your theme."
msgstr "Lägger till en knapp bredvid Lägg i varukorg som lägger till varan och öppnar kassan med denna betalningsmetod redan vald. Den lägger inte beställningen. Av som standard. Var den hamnar beror på ditt tema."

#: class/WC_Twoinc.php:6906
#, php-format
msgid "Minimum order value, %s"
msgstr "Minsta beställningsvärde, %s"

#: class/WC_Twoinc.php:6914
msgid "Minimum order value tax basis"
msgstr "Momsgrund för minsta beställningsvärde"

#: class/WC_Twoinc.php:6918
msgid "Including tax (gross)"
msgstr "Inklusive moms (brutto)"

#: class/WC_Twoinc.php:6919
msgid "Excluding tax (net)"
msgstr "Exklusive moms (netto)"

#: class/WC_Twoinc.php:6921
msgid "Whether the basket is compared against the minimum including or excluding tax."
msgstr "Om varukorgen jämförs med minimivärdet inklusive eller exklusive moms."

#: class/WC_Twoinc.php:6924
msgid "Pre-approve buyer during checkout"
msgstr "Förhandsgodkänna köparen i kassan"

#: class/WC_Twoinc.php:6925
msgid "Approve buyer when phone and company name is filled out."
msgstr "Godkänn köpare när telefon och företagsnamn är ifyllt"

#: class/WC_Twoinc.php:6932
#, php-format
msgid "Show \"What is %s\" link in checkout"
msgstr "Visa länken \"Vad är %s \" i kassan"

#: class/WC_Twoinc.php:6938
msgid "Display input tooltips"
msgstr "Visa verktygstips för inmatning"

#: class/WC_Twoinc.php:6952
msgid "Show invoice email field"
msgstr "Visa e-postfältet för faktura"

#: class/WC_Twoinc.php:6953
msgid "Adds an input field where buyers can input optional additional email address to receive invoice."
msgstr "Lägger till ett inmatningsfält där köpare kan ange valfri ytterligare e-postadress för att ta emot faktura."

#: class/WC_Twoinc.php:6960
msgid "Show PO number field"
msgstr "Visa fältet för PO-nummer"

#: class/WC_Twoinc.php:6961
msgid "Adds an input field where buyers can input their purchase order number to display on the invoice."
msgstr "Lägger till ett inmatningsfält där köpare kan ange sitt inköpsordernummer för att visas på fakturan."

#: class/WC_Twoinc.php:6968
msgid "Show project field"
msgstr "Visa fältet för projekt"

#: class/WC_Twoinc.php:6969
msgid "Adds an input field where buyers can input their project in the company to display on the invoice."
msgstr "Lägger till ett inmatningsfält där köpare kan mata in sitt projekt i företaget att visa på fakturan."

#: class/WC_Twoinc.php:6976
msgid "Show department field"
msgstr "Visa fältet för avdelning"

#: class/WC_Twoinc.php:6977
msgid "Adds an input field where buyers can input their department to display on the invoice."
msgstr "Lägger till ett inmatningsfält där köpare kan ange sin avdelning att visa på fakturan."

#: class/WC_Twoinc.php:6987
msgid "Enable company search in address entry"
msgstr "Aktivera företagssökning vid adressinmatning"

#: class/WC_Twoinc.php:6988
msgid "When enabled, the buyer may search for their company within the address entry section of the checkout. Otherwise, company search will be visible within the payment method."
msgstr "När detta är aktiverat kan köparen söka efter sitt företag i adressavsnittet i kassan. Annars visas företagssökningen i betalningsmetoden."

#: class/WC_Twoinc.php:6995
msgid "Autofill company address"
msgstr "Autofyll av företagsadress"

#: class/WC_Twoinc.php:6996
msgid "Enables automatically filling in the registered address from the national registry."
msgstr "Möjliggör att automatiskt fylla i den registrerade adressen från officiella register"

#: class/WC_Twoinc.php:7008 class/WC_Twoinc.php:7022 class/WC_Twoinc.php:7653
msgid "Payment terms"
msgstr "Betalningsvillkor"

#: class/WC_Twoinc.php:7011
msgid "Payment terms type"
msgstr "Betalningsvillkorstyp"

#: class/WC_Twoinc.php:7012
msgid "Standard counts the term days from the invoice date. End of month counts them from the end of the invoice month."
msgstr "Standard räknar terminsdagarna från fakturadatumet. Månadsslut räknar dem från slutet av fakturamånaden."

#: class/WC_Twoinc.php:7016
msgid "Standard (from invoice date)"
msgstr "Standard (från fakturadatum)"

#: class/WC_Twoinc.php:7017
msgid "End of month"
msgstr "Månadsskifte"

#: class/WC_Twoinc.php:7023
msgid "Select the payment term(s) you want to offer."
msgstr "Välj betalningsvillkor du vill erbjuda."

#: class/WC_Twoinc.php:7028
msgid "Custom payment terms (days)"
msgstr "Anpassade betalningsvillkor (dagar)"

#: class/WC_Twoinc.php:7034
msgid "Default payment terms"
msgstr "Standardbetalningsvillkor"

#: class/WC_Twoinc.php:7035
msgid "Select the payment term that will be automatically selected for your customer. Automatic leaves the choice to the checkout, which uses your own default term when you offer it."
msgstr "Välj det betalningsvillkor som automatiskt väljs för din kund. Automatiskt lämnar valet till kassan, som använder ditt eget standardvillkor när du erbjuder det."

#: class/WC_Twoinc.php:7042
msgid "Surcharge method"
msgstr "Tilläggsstrategi"

#: class/WC_Twoinc.php:7043
msgid "Select a method to surcharge your customer."
msgstr "Välj en metod för att debitera din kund."

#: class/WC_Twoinc.php:7047
msgid "No surcharge applied"
msgstr "Ingen tilläggsavgift appliceras"

#: class/WC_Twoinc.php:7048
msgid "Percentage"
msgstr "Procent"

#: class/WC_Twoinc.php:7049
msgid "Fixed fee"
msgstr "Fast belopp"

#: class/WC_Twoinc.php:7050
msgid "Fixed fee and percentage"
msgstr "Fast belopp och procent"

#: class/WC_Twoinc.php:7055
msgid "Surcharge calculation basis"
msgstr "Grund för tilläggsberäkning"

#: class/WC_Twoinc.php:7056
msgid "Total fee charges the configured surcharge for the chosen term. Fee difference charges only the difference versus the default term (which then shows no surcharge)."
msgstr "Totalavgift debiterar det konfigurerade tillägget för det valda villkoret. Avgiftsskillnad debiterar endast skillnaden mot standardvillkoret (som då inte visar något tillägg)."

#: class/WC_Twoinc.php:7060
msgid "Total fee for selected term"
msgstr "Total avgift för valt villkor"

#: class/WC_Twoinc.php:7061
msgid "Fee difference vs default payment term"
msgstr "Avgiftsskillnad mot standard betalningsvillkor"

#: class/WC_Twoinc.php:7066
msgid "Surcharge line description"
msgstr "Beskrivning av tilläggsavgift"

#: class/WC_Twoinc.php:7067
#, php-format
msgid "Buyer-facing label for the surcharge line. Use %s for the term length in days. Leave blank to use the brand default."
msgstr "Etikett som visas för köparen på tilläggsavgiftsraden. Använd %s för villkorets längd i dagar. Lämna fältet tomt för att använda varumärkets standardtext."

#: class/WC_Twoinc.php:7073
msgid "Surcharge tax treatment"
msgstr "Skattehantering av tillägg"

#: class/WC_Twoinc.php:7074
msgid "How the surcharge line is taxed. Standard applies your store's default tax rules to the fee. Specific tax class taxes the fee under a WooCommerce tax class you select below — to leave the fee untaxed, create a tax class with a 0% rate and select it here."
msgstr "Hur tilläggsraden beskattas. Standard tillämpar butikens standardskatteregler på avgiften. Specifik skatteklass beskattar avgiften enligt en WooCommerce-skatteklass du väljer nedan — för att lämna avgiften obeskattad, skapa en skatteklass med 0 % skattesats och välj den här."

#: class/WC_Twoinc.php:7096
msgid "Surcharge tax class"
msgstr "Skatteklass för tillägg"

#: class/WC_Twoinc.php:7097
msgid "The WooCommerce tax class applied to the surcharge when the tax treatment is \"Specific tax class\". Manage tax classes under WooCommerce → Settings → Tax."
msgstr "Den WooCommerce-skatteklass som tillämpas på tillägget när skattehanteringen är \"Specifik skatteklass\". Hantera skatteklasser under WooCommerce → Inställningar → Skatt."

#: class/WC_Twoinc.php:7107
msgid "Payment surcharge configuration"
msgstr "Konfiguration av tilläggsavgift"

#: class/WC_Twoinc.php:7117
msgid "Surcharge rounding"
msgstr "Avrundning av tillägg"

#: class/WC_Twoinc.php:7118
msgid "Snap the buyer surcharge line to a clean increment. Select None for standard two-decimal amounts."
msgstr "Avrunda köparens tilläggsavgiftsrad till ett jämnt steg. Välj Ingen för vanliga belopp med två decimaler."

#: class/WC_Twoinc.php:7122
msgid "None"
msgstr "Ingen"

#: class/WC_Twoinc.php:7123
msgid "Up"
msgstr "Uppåt"

#: class/WC_Twoinc.php:7124
msgid "Down"
msgstr "Nedåt"

#: class/WC_Twoinc.php:7130
msgid "Rounding step"
msgstr "Avrundningssteg"

#: class/WC_Twoinc.php:7131
msgid "Increment the surcharge is rounded to (e.g. 1 = whole units, 0.50 = nearest half). Applies only when a rounding direction is selected."
msgstr "Steget som tilläggsavgiften avrundas till (t.ex. 1 = hela enheter, 0,50 = närmaste halva). Gäller endast när en avrundningsriktning är vald."

#: class/WC_Twoinc.php:7140
msgid "Order management"
msgstr "Orderhantering"

#: class/WC_Twoinc.php:7143
msgid "Fulfilment trigger statuses"
msgstr "Utlösande statusar för uppfyllelse"

#. translators: %1$s and %2$s are both the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:7151
#, php-format
msgid "Which order status(es) tell %1$s an order is fulfilled. Defaults to \"Completed\" — add another status here (e.g. a custom status from another plugin) if your workflow never sets an order to Completed, otherwise %2$s is never notified and the order is left un-fulfilled indefinitely."
msgstr "Vilken/vilka orderstatus(ar) som talar om för %1$s att en order är levererad. Standard är \"Slutförd\" — lägg till en annan status här (t.ex. en anpassad status från ett annat tillägg) om ditt arbetsflöde aldrig sätter en order till Slutförd, annars meddelas aldrig %2$s och ordern lämnas outfyllda på obestämd tid."

#: class/WC_Twoinc.php:7159
msgid "Tax"
msgstr "Skatt"

#: class/WC_Twoinc.php:7162
msgid "Validate tax subtotals"
msgstr "Validera delsummor för skatt"

#: class/WC_Twoinc.php:7165
msgid "When checked, a per-tax-rate tax_subtotals breakdown is sent with orders, order updates and refunds, for validation against the order lines. When unchecked, tax_subtotals is omitted from all of them."
msgstr "När rutan är markerad skickas en tax_subtotals-uppdelning per momssats med ordrar, orderuppdateringar och återbetalningar, för validering mot orderraderna. När den inte är markerad utesluts tax_subtotals från alla dessa."

#: class/WC_Twoinc.php:7170
msgid "Tax codes for 0% lines"
msgstr "Momskoder för rader med 0 %"

#: class/WC_Twoinc.php:7177
msgid "Diagnostics"
msgstr "Diagnostik"

#: class/WC_Twoinc.php:7180
msgid "Disable checkout rate limiting"
msgstr "Inaktivera hastighetsbegränsning i kassan"

#: class/WC_Twoinc.php:7181
msgid "Serve the checkout AJAX endpoints unmetered"
msgstr "Servera kassans AJAX-slutpunkter utan hastighetsbegränsning"

#: class/WC_Twoinc.php:7183
msgid "The checkout AJAX endpoints spend your API key, so each client address is allowed a fixed number of requests per minute. Turn this on only if legitimate buyers are being refused — that happens when the store sits behind a reverse proxy or CDN and every buyer reaches PHP as the same address, which collapses the per-buyer allowance into a store-wide one. The lasting fix is to list the proxy below."
msgstr "Kassans AJAX-slutpunkter förbrukar din API-nyckel, så varje klientadress tillåts ett fast antal förfrågningar per minut. Aktivera detta endast om legitima köpare nekas — det händer när butiken sitter bakom en reverse proxy eller CDN och alla köpare når PHP som samma adress, vilket slår ihop den per-köpare-tillåtna mängden till en butiksomfattande. Den varaktiga lösningen är att lista proxyn nedan."

#: class/WC_Twoinc.php:7187
msgid "Trusted proxy addresses"
msgstr "Betrodda proxyadresser"

#: class/WC_Twoinc.php:7189
msgid "Addresses of your own reverse proxies, load balancers or CDN egress, as IPs or CIDR ranges, separated by commas or new lines. These IP addresses will be exempt from rate limiting."
msgstr "Adresser till dina egna reverse proxyservrar, lastbalanserare eller CDN-utgångar, som IP-adresser eller CIDR-intervall, separerade med kommatecken eller nya rader. Dessa IP-adresser undantas från hastighetsbegränsning."

#: class/WC_Twoinc.php:7194
msgid "Custom request headers"
msgstr "Anpassade begäranshuvuden"

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:7198
#, php-format
msgid "If your IT administrator asks you to add headers to the calls your store makes to the %s API (for example a firewall token), add them here. Every header listed is sent on all calls your store makes from your server."
msgstr "Om din IT-administratör ber dig lägga till huvuden på anropen som din butik gör mot %s-API:et (till exempel en brandväggstoken), lägger du till dem här. Alla huvuden i listan skickas på alla anrop som din butik gör från din server."

#: class/WC_Twoinc.php:7203
msgid "Disable SSL verification"
msgstr "Inaktivera SSL-verifiering"

#: class/WC_Twoinc.php:7204
msgid "Skip SSL certificate verification on outbound API requests"
msgstr "Hoppa över SSL-certifikatverifiering för utgående API-förfrågningar"

#: class/WC_Twoinc.php:7206
msgid "WARNING: this is unsafe for production and only intended for local/dev debugging behind a corporate proxy with custom SSL certificates. Applies in every environment, including Production, while enabled."
msgstr "VARNING: detta är osäkert för produktion och är endast avsett för lokal/dev-felsökning bakom en företagsproxy med anpassade SSL-certifikat. Gäller i alla miljöer, inklusive produktion, medan det är aktiverat."

#: class/WC_Twoinc.php:7210
msgid "Enable debug logging"
msgstr "Aktivera API-loggning"

#: class/WC_Twoinc.php:7211
msgid "Log API requests/responses and other diagnostic detail"
msgstr "Logga API-förfrågningar/-svar och annan diagnostisk information"

#: class/WC_Twoinc.php:7214
#, php-format
msgid "If enabled, API interactions and other diagnostic detail (e.g. surcharge/FX rounding) are logged. This can be useful for debugging. You can view the logs <a href=\"%s\">here</a>."
msgstr "Om aktiverat loggas API-interaktioner och annan diagnostisk information (t.ex. avrundning av tillägg/växelkurs). Detta kan vara användbart för felsökning. Du kan se loggarna <a href=\"%s\">här</a>."

#: class/WC_Twoinc.php:7220
msgid "Error log"
msgstr "Fellogg"

#: class/WC_Twoinc.php:7224
msgid "Skip user validation at order confirmation"
msgstr "Hoppa över användarvalidering vid orderbekräftelse"

#: class/WC_Twoinc.php:7225
msgid "Accept the confirmation callback without a valid WordPress security token"
msgstr "Godkänn bekräftelseanropet utan giltig WordPress-säkerhetstoken"

#: class/WC_Twoinc.php:7227
msgid "The confirmation callback always checks the order's unique 64-character order reference; this option skips only the additional WordPress security token, which typically expires 12 to 24 hours after the order was placed — and, for a signed-in customer, when their session changes — so a buyer who comes back to a legitimately authorised order can be rejected. The order reference must still match, so the callback is not left open, but the security token's protection against a cross-site request is gone; leave this off unless you are seeing those false rejections."
msgstr "Bekräftelseanropet kontrollerar alltid orderns unika orderreferens på 64 tecken; det här alternativet hoppar bara över den extra säkerhetstoken från WordPress, som vanligtvis upphör att gälla 12 till 24 timmar efter att ordern lades – och för en inloggad kund så snart sessionen ändras – vilket gör att en köpare som återvänder till en order som faktiskt har godkänts kan avvisas. Orderreferensen måste fortfarande stämma, så anropet står inte öppet, men skyddet som säkerhetstoken ger mot en förfrågan över webbplatsgränser är borta; lämna detta av om du inte ser sådana felaktiga avvisningar."

#: class/WC_Twoinc.php:7231
msgid "Clear settings on uninstall of plug-in"
msgstr "Rensa inställningar vid inaktivering av plugin"

#: class/WC_Twoinc.php:7237
msgid "Plugin version"
msgstr "Plugin-version"

#: class/WC_Twoinc.php:7241
msgid "Install health checklist"
msgstr "Installationschecklista"

#: class/WC_Twoinc.php:7245
msgid "Merchant profile"
msgstr "Säljarprofil"

#: class/WC_Twoinc.php:7304
msgid "Merchant ID:"
msgstr "Handlar-ID:"

#: class/WC_Twoinc.php:7308
#, php-format
msgid "Don't have an API key? Get one by signing up <a href='%s'>here</a>."
msgstr "Har du ingen API-nyckel? Skaffa en genom att registrera dig <a href='%s'>här</a> ."

#: class/WC_Twoinc.php:7356
msgid "Header name"
msgstr "Huvudnamn"

#: class/WC_Twoinc.php:7357
msgid "Value"
msgstr "Värde"

#: class/WC_Twoinc.php:7358
msgid "Also send from browser"
msgstr "Skicka även från webbläsaren"

#: class/WC_Twoinc.php:7373 class/WC_Twoinc.php:7379
msgid "This entry contains characters this field cannot hold, so it is not shown and is not being sent. Enter it again."
msgstr "Denna post innehåller tecken som detta fält inte kan hålla, så den visas inte och skickas inte. Skriv in den igen."

#: class/WC_Twoinc.php:7382
msgid "This row is not being sent, and the settings cannot be saved until it is corrected or removed."
msgstr "Denna rad skickas inte och inställningarna kan inte sparas förrän den har rättats eller tagits bort."

#: class/WC_Twoinc.php:7391
msgid "Add header"
msgstr "Lägg till huvud"

#: class/WC_Twoinc.php:7393
msgid "Tick \"Also send from browser\" only if your IT administrator requires the header on calls from the buyer's browser as well as those from your server. Its value will be published to the buyer's browser and may be read by anyone."
msgstr "Markera \"Skicka även från webbläsaren\" endast om din IT-administratör kräver huvudet på anrop från köparens webbläsare utöver dem från din server. Värdet publiceras till köparens webbläsare och kan läsas av vem som helst."

#: class/WC_Twoinc.php:7423
msgid "Every custom request header needs a name."
msgstr "Varje anpassat begäranshuvud måste ha ett namn."

#. translators: %s: the rejected header name
#: class/WC_Twoinc.php:7428
#, php-format
msgid "\"%s\" is not a valid HTTP header name. Use letters, digits and hyphens."
msgstr "\"%s\" är inte ett giltigt HTTP-huvudnamn. Använd bokstäver, siffror och bindestreck."

#. translators: %s: the rejected header name
#: class/WC_Twoinc.php:7436
#, php-format
msgid "The header \"%s\" is reserved and cannot be set from this table."
msgstr "Huvudet \"%s\" är reserverat och kan inte anges från denna tabell."

#. translators: %s: the header name whose value was rejected
#: class/WC_Twoinc.php:7443
#, php-format
msgid "The value of \"%s\" must be printable ASCII text and cannot be blank."
msgstr "Värdet för \"%s\" måste vara skrivbar ASCII-text och får inte vara tomt."

#. translators: %s: the duplicated header name
#: class/WC_Twoinc.php:7450
#, php-format
msgid "The header \"%s\" is listed more than once."
msgstr "Huvudet \"%s\" är listat mer än en gång."

#: class/WC_Twoinc.php:7528
msgid "Select image"
msgstr "Välj bild"

#: class/WC_Twoinc.php:7551
msgid "View error log"
msgstr "Visa fellogg"

#: class/WC_Twoinc.php:7554
msgid "Opens the WooCommerce log viewer filtered to this plugin's log entries."
msgstr "Öppnar WooCommerce-loggvisaren filtrerad till detta tilläggs loggposter."

#: class/WC_Twoinc.php:7589
msgid "Refresh merchant profile"
msgstr "Uppdatera säljarprofil"

#. translators: %s is the brand product name (e.g. "Two")
#: class/WC_Twoinc.php:7604
#, php-format
msgid "Your offerable payment terms, buyer-surcharge cap, minimum order value and default term are read from %s and cached. They are refreshed every night and whenever the API key or environment is saved; use this to pull a change through now. The nightly refresh runs on WP-Cron. With WP-Cron disabled, the next request more than 24 hours after the last refresh re-reads it, and while a re-read keeps failing one request a minute retries it."
msgstr "De betalningsvillkor du kan erbjuda, taket för köpartillägget, minsta ordervärde och standardvillkoret hämtas från %s och cachas. De uppdateras varje natt och varje gång API-nyckeln eller miljön sparas; använd detta för att hämta in en ändring nu. Den nattliga uppdateringen körs på WP-Cron. Med WP-Cron avstängt läser den första förfrågan mer än 24 timmar efter senaste uppdateringen om den, och så länge en ny läsning fortsätter att misslyckas gör en förfrågan per minut ett nytt försök."

#: class/WC_Twoinc.php:7633
msgid "API key"
msgstr "API-nyckel"

#: class/WC_Twoinc.php:7634
msgid "Configured"
msgstr "Konfigurerad"

#: class/WC_Twoinc.php:7634
msgid "Not configured"
msgstr "Inte konfigurerad"

#: class/WC_Twoinc.php:7643
msgid "SSL verification"
msgstr "SSL-verifiering"

#: class/WC_Twoinc.php:7644
msgid "Disabled"
msgstr "Avaktiverad"

#: class/WC_Twoinc.php:7644
msgid "Enabled"
msgstr "Aktiverad"

#: class/WC_Twoinc.php:7648
msgid "PHP curl extension"
msgstr "PHP curl-tillägg"

#: class/WC_Twoinc.php:7649
msgid "Present"
msgstr "Finns"

#: class/WC_Twoinc.php:7649
msgid "Missing"
msgstr "Saknas"

#: class/WC_Twoinc.php:7658
msgid "Merchant profile last read"
msgstr "Säljarprofil senast läst"

#: class/WC_Twoinc.php:7682
msgid "SSL verification is disabled while the environment is not production-hardened; re-check the \"Disable SSL verification\" setting."
msgstr "SSL-verifiering är inaktiverad medan miljön inte är produktionssäkrad; kontrollera inställningen \"Inaktivera SSL-verifiering\" igen."

#: class/WC_Twoinc.php:7699 class/WC_Twoinc.php:7729
msgid "Unable to retrieve the order information."
msgstr "Det gick inte att hämta beställningsinformationen."

#: class/WC_Twoinc.php:7735
msgid "Unable to retrieve the order payment information"
msgstr "Det gick inte att hämta betalningsinformationen"

#: class/WC_Twoinc.php:7741
msgid "Missing company ID."
msgstr "Företags-ID saknas."

#: class/WC_Twoinc.php:7828
#, php-format
msgid "Could not update the order with %s. Reason: %s"
msgstr "Kunde inte uppdatera ordern med %s. Orsak: %s"

#: class/WC_Twoinc.php:7917
#, php-format
msgid "This change was saved in WooCommerce but was not sent to %1$s, which no longer accepts edits to this order. The %1$s invoice does not include it."
msgstr "Denna ändring sparades i WooCommerce men skickades inte till %1$s, som inte längre tar emot ändringar av denna order. %1$s-fakturan innehåller den inte."

#: class/WC_Twoinc.php:7937 class/WC_Twoinc.php:7969 class/WC_Twoinc.php:7976
#, php-format
msgid "Could not edit the order with %s."
msgstr "Kunde inte redigera beställningen med %s ."

